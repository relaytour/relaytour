generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/client"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

generator pothos {
  provider     = "prisma-pothos-types"
  clientOutput = "./client"
  output       = "../src/generated/pothos-types.ts"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Règle des migrations : additives seulement. Un sens nouveau prend un nom de champ nouveau.

// ── Organisation (ADR 0006 et 0008) ──────────────────────────────────────────

// ACTIVE : tout est permis. LECTURE_SEULE : les membres lisent, personne n'écrit.
// SUSPENDUE et ARCHIVEE : aucun contexte. L'export par l'administration de
// l'installation reste possible dans tous les statuts.
enum StatutOrganisation {
  ACTIVE
  LECTURE_SEULE
  SUSPENDUE
  ARCHIVEE
}

// Racine des données d'une organisation. Elle porte une ou plusieurs activités.
model Organisation {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  nom                  String
  sigle                String?
  fuseauHoraire        String             @default("Europe/Paris")
  // Déclaration complète (organisation.yaml), validée par DeclarationOrganisationSchema
  // dans packages/server/src/lib/organisation.ts.
  configuration        Json
  statut               StatutOrganisation @default(ACTIVE)
  // Plafonds fixés par l'administration de l'installation (ADR 0008) :
  // { activites?: number, periodesOuvertes?: number }. Nul ou vide : aucune limite.
  // Une limite bloque une création, jamais la lecture ni l'export.
  limites              Json?
  // Source de vérité du contenu (ADR 0009) : dernière modification faite dans
  // l'application, et dernier import ou export du dossier de contenu. Un import
  // refuse d'écraser une modification plus récente que la dernière synchronisation.
  contenuModifieLe     DateTime?
  contenuSynchroniseLe DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  activites               Activite[]
  appartenances           Appartenance[]
  editions                Edition[]
  perimetres              Perimetre[]
  fiches                  Fiche[]
  notifications           Notification[]
  preferences             PreferenceNotification[]
  preferencesOrganisation PreferenceOrganisation[]
  droitsRedaction         DroitRedaction[]
  medias                  Media[]
  adminsActivite          AdminActivite[]
  rattachementsActivite   RattachementActivite[]
  demandes                Demande[]
  messages                Message[]
  invitations             InvitationOrganisation[]
  datesCles               DateCle[]
  reunions                Reunion[]
  abonnementsAgenda       AbonnementAgenda[]
  sondages                Sondage[]
  lieux                   Lieu[]
  sequences               Sequence[]
  benevoles               Benevole[]
  appelsBenevoles         AppelBenevoles[]
  correspondancesImport   CorrespondanceImport[]
  pairesDistinctes        PaireDistincte[]
  candidatures            Candidature[]
  connexionFichiers       ConnexionFichiers?
  dossiersLies            DossierLie[]
  ressourcesFiches        RessourceFiche[]
  comptesFournisseur      CompteFournisseur[]
  etatsAccesDossiers      EtatAccesDossier[]
  propositionsAcces       PropositionAcces[]
  permissionsCreees       PermissionCreee[]
  fichesExportees         FicheExportee[]
}

// Image d'une organisation ou d'une activité (ADR 0009) : logo ou favicon. Le
// fichier vit en base, avec les sauvegardes, et se sert par son empreinte.
model Media {
  id             String    @id @default(cuid())
  organisationId String
  // SHA-256 du fichier, en hexadécimal : l'adresse publique de l'image.
  empreinte      String
  // image/png ou image/svg+xml.
  type           String
  octets         Int
  donnees        Bytes     @db.MediumBlob
  createdAt      DateTime  @default(now())
  // Date à laquelle la purge a constaté qu'aucune identité ne cite plus l'image ;
  // nulle tant qu'elle est citée. L'image est supprimée 30 jours après.
  orphelinDepuis DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, empreinte])
  @@index([empreinte])
}

enum RoleOrganisation {
  ADMIN
  MEMBRE
}

// Un compte est global ; il appartient à une ou plusieurs organisations, avec un
// rôle par organisation (ADR 0008). Le rôle vaut pour toutes les activités.
model Appartenance {
  id             String           @id @default(cuid())
  userId         String
  organisationId String
  role           RoleOrganisation @default(MEMBRE)
  // Date à laquelle la personne a été archivée dans cette organisation (ADR 0031).
  // Nulle, l'appartenance est active. L'archivage ne touche ni le compte ni ses
  // autres organisations.
  archiveLe      DateTime?
  // Accord de la personne pour afficher son adresse dans l'organigramme des
  // activités de cette organisation (ADR 0036). Elle seule le change.
  adresseVisible Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([userId, organisationId])
  @@index([organisationId])
}

enum OrigineInvitation {
  // Un admin, par l'espace organisateur : `inviteParId` le désigne.
  PERSONNE
  // La commande equipe-importer (ADR 0013), sans personne connectée.
  IMPORT
  // L'administration de l'installation (ADR 0008) : le premier admin d'une organisation.
  INSTALLATION
}

// Invitation d'un compte qui existe déjà hors de l'organisation (ADR 0030). Les
// organisations d'une installation sont cloisonnées : rien n'est écrit au nom de la
// personne (appartenance, affectation, souhait) tant qu'elle n'a pas accepté.
// L'organisation ne lit de cette ligne que ce qu'elle a saisi : le nom, l'adresse
// et les périmètres. Une invitation expirée n'existe plus pour personne ; la purge
// nocturne efface sa ligne.
model InvitationOrganisation {
  id             String            @id @default(cuid())
  organisationId String
  userId         String
  role           RoleOrganisation  @default(MEMBRE)
  // Le nom saisi par la personne qui invite. Le nom du compte reste inconnu de
  // l'organisation jusqu'à l'acceptation.
  nom            String
  origine        OrigineInvitation
  inviteParId    String?
  // Vrai pour une invitation sans périmètre, faite au niveau de l'organisation :
  // elle demeure quand un admin d'activité retire les périmètres de son activité.
  globale        Boolean           @default(false)
  // Ce que l'acceptation créera, par période : `[{ editionId, activiteId, affectes,
  // souhaites, contactPrincipal }]`, des identifiants de périmètres (lib/invitations.ts).
  lots           Json
  // Les activités où l'acceptation rattache la personne sans périmètre (ADR 0045) :
  // des identifiants d'activités. Null pour une invitation d'avant cette décision.
  rattachements  Json?
  expireLe       DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         User         @relation("InvitationRecue", fields: [userId], references: [id], onDelete: Cascade)
  invitePar    User?        @relation("InvitationEnvoyee", fields: [inviteParId], references: [id], onDelete: SetNull)

  @@unique([organisationId, userId])
  @@index([userId])
  @@index([inviteParId])
}

// Admin d'une activité (ADR 0010) : les droits d'un admin, limités à cette
// activité. Un admin de l'organisation (Appartenance.role ADMIN) les a sur toutes.
// La personne reste membre de l'organisation.
model AdminActivite {
  id             String   @id @default(cuid())
  userId         String
  activiteId     String
  organisationId String
  nommeParId     String?
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activite     Activite     @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([userId, activiteId])
  @@index([organisationId])
  @@index([activiteId])
}

// Rattachement d'une personne à une activité, sans périmètre ni période (ADR 0045).
// Il la fait entrer dans l'équipe de l'activité, et lui ouvre la découverte : la
// page « Tous les périmètres ». Chaque affectation crée aussi le rattachement.
model RattachementActivite {
  id             String   @id @default(cuid())
  userId         String
  activiteId     String
  organisationId String
  creeParId      String?
  createdAt      DateTime @default(now())

  user         User         @relation("RattachementPersonne", fields: [userId], references: [id], onDelete: Cascade)
  activite     Activite     @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  creePar      User?        @relation("RattachementAuteur", fields: [creeParId], references: [id], onDelete: SetNull)

  @@unique([userId, activiteId])
  @@index([organisationId])
  @@index([activiteId])
  @@index([creeParId])
}

// La nature fixe le libellé de la période : édition, saison ou mandat.
enum NatureActivite {
  EVENEMENT
  SAISON
  MANDAT
}

// Ce qu'une organisation fait dans la durée : un événement, une section, une
// instance (ADR 0008). Elle porte ses périodes (Edition), ses périmètres, ses
// fiches et ses tâches types.
// Étendue des adresses personnelles de l'organigramme d'une activité (ADR 0036).
enum AdressesOrganigramme {
  // Aucune adresse personnelle : des noms et le contact de l'activité.
  AUCUNE
  // Les admins de l'activité et les contacts principaux.
  CONTACTS
  // Les admins, les contacts principaux, et toutes les référentes et tous les référents.
  REFERENTS
}

model Activite {
  id                   String               @id @default(cuid())
  organisationId       String
  slug                 String
  nom                  String
  sigle                String?
  nature               NatureActivite       @default(EVENEMENT)
  // Groupes de périmètres déclarés dans le contenu, dans l'ordre d'affichage :
  // [{ cle, libelle, libellePluriel }]. Le gabarit propose sport et pole.
  groupes              Json
  // Phases déclarées dans le contenu, dans l'ordre (ADR 0025) :
  // [{ cle, libelle, jusquA }], avec une borne en jours depuis le premier jour de la
  // période (J-120), sauf sur la dernière phase. Null : phases par défaut.
  phases               Json?
  ordre                Int                  @default(0)
  // Identité propre à l'activité (ADR 0009) : contacts, logo, couleurs et fond.
  // Chaque champ absent reprend la valeur de l'organisation.
  identite             Json?
  // Ouverte aux souhaits (ADR 0012) : tous les membres de l'organisation découvrent
  // ses périmètres et formulent leurs souhaits, sans lire ses tâches ni ses fiches.
  souhaitsOuverts      Boolean              @default(false)
  // Formulaire public pour rejoindre l'équipe (ADR 0015) : texte d'introduction,
  // question complémentaire et paliers de disponibilité. C'est du contenu, importé
  // et exporté avec l'activité.
  formulaire           Json?
  // Ouverture du formulaire public. En base seulement : un import de contenu ne
  // l'ouvre ni ne le ferme jamais.
  formulaireOuvert     Boolean              @default(false)
  // Adresses personnelles que l'organigramme peut afficher (ADR 0036), avec
  // l'accord de chaque personne. En base seulement : un import ne le change jamais.
  adressesOrganigramme AdressesOrganigramme @default(AUCUNE)
  archivedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  organisation          Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  editions              Edition[]
  perimetres            Perimetre[]
  fiches                Fiche[]
  admins                AdminActivite[]
  rattachements         RattachementActivite[]
  demandes              Demande[]
  messages              Message[]
  notifications         Notification[]
  datesCles             DateCle[]
  reunions              Reunion[]
  abonnements           AbonnementAgenda[]
  sondages              Sondage[]
  lieux                 Lieu[]
  sequences             Sequence[]
  benevoles             Benevole[]
  appelsBenevoles       AppelBenevoles[]
  correspondancesImport CorrespondanceImport[]
  pairesDistinctes      PaireDistincte[]
  candidatures          Candidature[]
  dossiersLies          DossierLie[]

  @@unique([organisationId, slug])
}

// ── Authentification (Better Auth) ────────────────────────────────────────────
// Les champs de ces quatre tables suivent les conventions de Better Auth 1.7.
// `isAdmin` et `archivedAt` sont des champs supplémentaires déclarés dans auth.ts.

model User {
  id                       String    @id
  name                     String
  email                    String    @unique
  emailVerified            Boolean   @default(false)
  image                    String?   @db.Text
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  isAdmin                  Boolean   @default(false)
  // Valeur dérivée depuis l'ADR 0031 : une date quand le compte n'a aucune
  // appartenance active, rien sinon. Le code ne la lit plus pour décider d'un accès
  // (`Appartenance.archiveLe` fait foi) ; il la tient à jour pour un retour à une
  // version antérieure, qui la lit encore. Le champ change de nom dans le code pour
  // qu'aucune lecture ne le prenne pour l'archivage d'une personne ; la colonne garde
  // le sien.
  sansAppartenanceActiveLe DateTime? @map("archivedAt")
  // Langue choisie par la personne pour l'interface, les mails et les notifications
  // (ADR 0047). Sans choix, la langue de l'organisation s'applique.
  langue                   String?   @db.VarChar(16)

  sessions                Session[]
  accounts                Account[]
  affectations            Affectation[]            @relation("AffectationUtilisateur")
  affectationsCreees      Affectation[]            @relation("AffectationAuteur")
  tachesCreees            Tache[]                  @relation("TacheAuteur")
  commentaires            CommentaireTache[]       @relation("CommentaireAuteur")
  tachesCloturees         Tache[]                  @relation("TacheCloture")
  tachesRealisees         Tache[]                  @relation("TacheRealisation")
  tachesAccordees         Tache[]                  @relation("TacheAccord")
  versionsFiches          FicheVersion[]
  fichesConnexesAjoutees  FicheConnexe[]           @relation("FicheConnexeAuteur")
  groupesConnexesAjoutes  FicheGroupeConnexe[]     @relation("FicheGroupeConnexeAuteur")
  fichesConnexesMasquees  FicheConnexeMasquee[]    @relation("FicheConnexeMasqueePar")
  droitsRedaction         DroitRedaction[]         @relation("DroitRedactionPersonne")
  droitsAccordes          DroitRedaction[]         @relation("DroitRedactionAuteur")
  notifications           Notification[]           @relation("NotificationDestinataire")
  preferences             PreferenceNotification?
  preferencesOrganisation PreferenceOrganisation[]
  abonnementsPush         AbonnementPush[]
  assignations            TacheAssignation[]
  journal                 Journal[]                @relation("JournalActeur")
  souhaits                Souhait[]
  appartenances           Appartenance[]
  adminsActivite          AdminActivite[]
  rattachementsActivite   RattachementActivite[]   @relation("RattachementPersonne")
  rattachementsCrees      RattachementActivite[]   @relation("RattachementAuteur")
  demandes                Demande[]                @relation("DemandeCompte")
  demandesTraitees        Demande[]                @relation("DemandeTraitement")
  propositions            DemandePerimetre[]
  invitationsRecues       InvitationOrganisation[] @relation("InvitationRecue")
  invitationsEnvoyees     InvitationOrganisation[] @relation("InvitationEnvoyee")
  messagesEcrits          Message[]                @relation("MessageAuteur")
  messagesRecus           MessageDestinataire[]
  datesClesCreees         DateCle[]                @relation("DateCleAuteur")
  reunionsCreees          Reunion[]                @relation("ReunionAuteur")
  convocations            ConvocationReunion[]
  abonnementsAgenda       AbonnementAgenda[]       @relation("AbonnementPersonne")
  abonnementsCrees        AbonnementAgenda[]       @relation("AbonnementAuteur")
  sondagesCrees           Sondage[]                @relation("SondageAuteur")
  participationsSondage   ParticipantSondage[]
  reponsesSondage         ReponseSondage[]
  sequencesCreees         Sequence[]               @relation("SequenceAuteur")
  placesSequence          PlaceSequence[]
  benevolesCrees          Benevole[]               @relation("BenevoleAuteur")
  appelsBenevolesCrees    AppelBenevoles[]         @relation("AppelBenevolesAuteur")
  correspondancesCreees   CorrespondanceImport[]   @relation("CorrespondanceImportAuteur")
  pairesDistinctesCreees  PaireDistincte[]         @relation("PaireDistincteAuteur")
  choixTraites            ChoixCandidature[]       @relation("ChoixCandidatureTraitement")
  connexionsFichiers      ConnexionFichiers[]
  dossiersLies            DossierLie[]
  ressourcesFiches        RessourceFiche[]
  comptesFournisseur      CompteFournisseur[]
  etatsAccesDossiers      EtatAccesDossier[]
  propositionsAcces       PropositionAcces[]       @relation("PropositionPersonne")
  propositionsTraitees    PropositionAcces[]       @relation("PropositionTraitee")
  permissionsCreees       PermissionCreee[]
  ressourcesOuvertes      RessourceFiche[]         @relation("RessourceOuvertePar")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

// ── Organisation ─────────────────────────────────────────────────────────────

enum StatutEdition {
  PREPARATION
  EN_COURS
  ARCHIVEE
}

// Une période d'une activité : l'édition d'un événement, la saison d'une section,
// le mandat d'une instance. `annee` est l'année de début. Ses dates servent de
// référence aux échéances relatives des tâches.
model Edition {
  id             String        @id @default(cuid())
  organisationId String
  activiteId     String
  annee          Int
  nom            String
  debut          DateTime      @db.Date
  fin            DateTime      @db.Date
  statut         StatutEdition @default(PREPARATION)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation        Organisation?        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  activite            Activite             @relation(fields: [activiteId], references: [id], onDelete: Restrict)
  affectations        Affectation[]
  taches              Tache[]
  journal             Journal[]
  effectifs           EffectifPerimetre[]
  souhaits            Souhait[]
  demandes            Demande[]
  messages            Message[]
  datesCles           DateCle[]
  reunions            Reunion[]
  sondages            Sondage[]
  sequences           Sequence[]
  appelsBenevoles     AppelBenevoles[]
  candidatures        Candidature[]
  plagesDisponibilite PlageDisponibilite[]

  @@unique([activiteId, annee])
  @@index([organisationId])
}

enum TypePerimetre {
  SPORT
  POLE
}

// Une sous-partie d'une activité (un sport, un pôle, une commission…), rangée dans
// un groupe déclaré par l'activité. Il est stable d'une période à l'autre.
// `type` reste rempli pour l'historique ; `groupe` le remplace (ADR 0008).
model Perimetre {
  id                String        @id @default(cuid())
  organisationId    String
  activiteId        String
  slug              String
  nom               String
  type              TypePerimetre
  groupe            String
  couleur           String?
  // Une ou deux phrases qui présentent le périmètre (ADR 0012) : la page « Tous les
  // périmètres », la page du périmètre et les mails d'équipe l'affichent.
  description       String?       @db.Text
  ordre             Int           @default(0)
  // Effectif déclaré dans le contenu, repris pour chaque nouvelle période.
  effectifParDefaut Int?
  // Tâches types du périmètre, telles que le contenu les déclare (ADR 0009) :
  // l'export les réécrit sans les reconstituer depuis les tâches d'une période.
  tachesTypes       Json?
  archivedAt        DateTime?
  // Compte les modifications du réglage (nom, groupe, description, couleur, ordre,
  // archivage). Une modification porte la version lue : le serveur refuse d'écraser
  // un changement fait entre-temps.
  version           Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organisation      Organisation?         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  activite          Activite              @relation(fields: [activiteId], references: [id], onDelete: Restrict)
  affectations      Affectation[]
  taches            Tache[]
  journal           Journal[]
  fiches            Fiche[]
  droitsRedaction   DroitRedaction[]
  effectifs         EffectifPerimetre[]
  souhaits          Souhait[]
  demandes          DemandePerimetre[]
  messages          Message[]
  reunions          Reunion[]
  sondages          Sondage[]
  sequences         Sequence[]
  appelsBenevoles   AppelBenevoles[]
  benevolesImportes Benevole[]
  dossiersLies      DossierLie[]
  // Dossiers liés dont la liste de lecteurs nomme ce périmètre (ADR 0043).
  dossiersLecteur   DossierLiePerimetre[]
  // Fiches d'autres périmètres qui concernent aussi celui-ci (ADR 0039).
  fichesConnexes    FicheConnexe[]
  fichesMasquees    FicheConnexeMasquee[]

  @@unique([activiteId, slug])
  @@index([organisationId])
}

// Une personne désignée pour un périmètre et une édition.
// Les suppressions sont bloquées (Restrict) : l'historique des éditions reste intact.
model Affectation {
  id               String   @id @default(cuid())
  userId           String
  perimetreId      String
  editionId        String
  creeParId        String?
  createdAt        DateTime @default(now())
  // Contact principal du périmètre pour l'édition (ADR 0011) : une information pour
  // l'organisation, sans droit supplémentaire. La mutation definirContactPrincipal
  // en garde une seule par périmètre et par édition.
  contactPrincipal Boolean  @default(false)

  user      User      @relation("AffectationUtilisateur", fields: [userId], references: [id], onDelete: Restrict)
  perimetre Perimetre @relation(fields: [perimetreId], references: [id], onDelete: Restrict)
  edition   Edition   @relation(fields: [editionId], references: [id], onDelete: Restrict)
  creePar   User?     @relation("AffectationAuteur", fields: [creeParId], references: [id], onDelete: SetNull)

  @@unique([userId, perimetreId, editionId])
  @@index([perimetreId, editionId])
  @@index([editionId])
}

// Nombre de référentes et de référents souhaité pour un périmètre et une édition.
// La valeur par défaut vient de content/orga/perimetres.yaml : l'import d'une édition
// la crée si elle manque et ne la remplace jamais. Les admins la modifient dans l'app.
// Réglage sans historique : il suit la suppression du périmètre ou de l'édition (Cascade).
model EffectifPerimetre {
  id          String   @id @default(cuid())
  perimetreId String
  editionId   String
  effectif    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  perimetre Perimetre @relation(fields: [perimetreId], references: [id], onDelete: Cascade)
  edition   Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([perimetreId, editionId])
  @@index([editionId])
}

// Intérêt d'une personne pour un périmètre d'une édition, noté par un admin.
// Un souhait ne donne aucun accès : seule l'affectation ouvre les droits.
// Il est satisfait quand l'affectation correspondante existe ; l'affectation ne le
// modifie pas. Visible des admins seulement, jamais exporté dans Git.
// Cascade : un souhait n'a pas d'historique propre et suit la suppression de ses parents.
model Souhait {
  id          String   @id @default(cuid())
  userId      String
  perimetreId String
  editionId   String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  perimetre Perimetre @relation(fields: [perimetreId], references: [id], onDelete: Cascade)
  edition   Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([userId, perimetreId, editionId])
  @@index([perimetreId, editionId])
  @@index([editionId])
}

// ── Demandes pour rejoindre l'équipe (ADR 0015) ───────────────────────────────

enum OrigineDemande {
  PROPOSITION
  FORMULAIRE
}

enum StatutDemande {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

// Une personne qui demande à rejoindre l'équipe d'une période : proposée par un·e
// référent·e pour son périmètre, ou venue du formulaire public. Aucun compte n'existe
// avant qu'un admin accepte la demande. Elle porte le nom et l'adresse d'une personne
// qui n'est pas encore membre : elle vit en base seulement, et suit la suppression
// de sa période (Cascade).
model Demande {
  id               String         @id @default(cuid())
  organisationId   String
  activiteId       String
  editionId        String
  origine          OrigineDemande
  statut           StatutDemande  @default(EN_ATTENTE)
  nom              String
  adresse          String
  // L'adresse tant que la demande attend, puis null : la contrainte d'unicité garde
  // une seule demande en attente par adresse et par période.
  adresseEnAttente String?
  // Réponses du formulaire public : le palier de disponibilité choisi et la question
  // complémentaire (leurs libellés au moment du dépôt, que le réglage peut changer
  // ensuite), la réponse à cette question, et le texte libre.
  disponibilite    String?
  question         String?
  reponse          String?
  texte            String?        @db.VarChar(600)
  // Le compte créé ou rattaché par l'acceptation.
  userId           String?
  traiteeParId     String?
  traiteeLe        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  activite     Activite           @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  edition      Edition            @relation(fields: [editionId], references: [id], onDelete: Cascade)
  user         User?              @relation("DemandeCompte", fields: [userId], references: [id], onDelete: SetNull)
  traiteePar   User?              @relation("DemandeTraitement", fields: [traiteeParId], references: [id], onDelete: SetNull)
  perimetres   DemandePerimetre[]

  @@unique([editionId, adresseEnAttente])
  @@index([editionId, statut, createdAt])
  @@index([organisationId])
  @@index([activiteId])
}

// Un périmètre demandé : proposé par un·e référent·e, ou choisi dans le formulaire
// public (sans auteur). Le mot facultatif accompagne une proposition. Deux personnes
// qui proposent la même adresse pour le même périmètre ont chacune leur ligne : la
// liste de chacune se comporte comme pour une adresse inconnue.
model DemandePerimetre {
  id           String   @id @default(cuid())
  demandeId    String
  perimetreId  String
  proposeParId String?
  mot          String?  @db.VarChar(280)
  createdAt    DateTime @default(now())

  demande    Demande   @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  perimetre  Perimetre @relation(fields: [perimetreId], references: [id], onDelete: Cascade)
  proposePar User?     @relation(fields: [proposeParId], references: [id], onDelete: SetNull)

  @@unique([demandeId, perimetreId, proposeParId])
  @@index([perimetreId])
  @@index([proposeParId])
}

// ── Messages ─────────────────────────────────────────────────────────────────

enum StatutMessage {
  EN_COURS
  ENVOYE
  ANNULE
}

// Le champ de la messagerie qui reçoit les destinataires : « À » pour une seule
// personne, « Cc » (adresses visibles) ou « Cci » (adresses cachées) pour plusieurs.
enum ChampDestinataires {
  A
  CC
  CCI
}

// Un message qu'un admin prépare dans l'application et envoie depuis sa propre
// messagerie (ADR 0020). L'application n'envoie rien : elle garde le texte préparé
// et l'état que l'auteur déclare. Les destinataires sont des comptes, jamais des
// adresses. Sans activité, le message vient de l'annuaire : seuls les admins de
// l'organisation le lisent. Un message vit en base seulement.
model Message {
  id             String             @id @default(cuid())
  organisationId String
  activiteId     String?
  editionId      String?
  perimetreId    String?
  auteurId       String?
  // La clé du modèle de départ, connue de l'espace organisateur.
  modele         String             @db.VarChar(60)
  objet          String             @db.VarChar(200)
  corps          String             @db.Text
  champ          ChampDestinataires
  statut         StatutMessage      @default(EN_COURS)
  // Le moment où l'auteur a déclaré le message envoyé ou annulé.
  statutLe       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organisation  Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  activite      Activite?             @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  edition       Edition?              @relation(fields: [editionId], references: [id], onDelete: SetNull)
  perimetre     Perimetre?            @relation(fields: [perimetreId], references: [id], onDelete: SetNull)
  auteur        User?                 @relation("MessageAuteur", fields: [auteurId], references: [id], onDelete: SetNull)
  destinataires MessageDestinataire[]

  @@index([organisationId, createdAt])
  @@index([activiteId, createdAt])
  @@index([editionId])
  @@index([perimetreId])
  @@index([auteurId])
}

// Un destinataire d'un message. `enCopie` : la personne figure en copie visible
// (Cc) d'un message dont les autres destinataires sont en copie cachée.
model MessageDestinataire {
  id        String  @id @default(cuid())
  messageId String
  userId    String
  enCopie   Boolean @default(false)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

// ── Tâches ───────────────────────────────────────────────────────────────────

enum StatutTache {
  A_FAIRE
  EN_COURS
  FAITE
  ABANDONNEE
}

// Accord du périmètre cible sur une déclinaison (ADR 0026). EN_ATTENTE : la
// déclinaison est proposée, et ne compte pas encore parmi les tâches du périmètre.
enum AccordDeclinaison {
  EN_ATTENTE
  ACCEPTE
  REFUSE
}

// Action datée d'un périmètre pour une édition. Une tâche ne se supprime pas :
// elle s'abandonne, pour garder l'historique.
model Tache {
  id            String             @id @default(cuid())
  editionId     String
  perimetreId   String
  titre         String
  description   String?            @db.Text
  echeance      DateTime?          @db.Date
  statut        StatutTache        @default(A_FAIRE)
  // Identifiant du modèle Git d'origine (phase 3), null pour une tâche créée dans l'app.
  modeleSlug    String?
  ficheId       String?
  creeParId     String?
  // Personne qui a coché la tâche, et personne qui l'a réalisée si elle l'a indiqué.
  // Ces deux champs ne sont lisibles que par la personne qui a coché et par les admins.
  termineeLe    DateTime?
  clotureeParId String?
  realiseeParId String?
  // Compte les modifications du contenu (titre, description, échéance, fiche). Une
  // modification porte la version lue : le serveur refuse d'écraser un changement
  // fait entre-temps. Le statut et les assignations ne changent pas la version.
  version       Int                @default(0)
  // Tâche partagée dont celle-ci est la déclinaison dans son périmètre (ADR 0026).
  // Null pour une tâche ordinaire et pour la tâche partagée elle-même. Une
  // déclinaison ne se décline pas.
  origineId     String?
  // Accord du périmètre cible, pour une déclinaison seulement : qui l'a donné ou
  // refusé, et quand.
  accord        AccordDeclinaison?
  accordParId   String?
  accordLe      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  edition       Edition            @relation(fields: [editionId], references: [id], onDelete: Restrict)
  perimetre     Perimetre          @relation(fields: [perimetreId], references: [id], onDelete: Restrict)
  creePar       User?              @relation("TacheAuteur", fields: [creeParId], references: [id], onDelete: SetNull)
  clotureePar   User?              @relation("TacheCloture", fields: [clotureeParId], references: [id], onDelete: SetNull)
  realiseePar   User?              @relation("TacheRealisation", fields: [realiseeParId], references: [id], onDelete: SetNull)
  fiche         Fiche?             @relation(fields: [ficheId], references: [id], onDelete: SetNull)
  origine       Tache?             @relation("Declinaisons", fields: [origineId], references: [id], onDelete: Restrict)
  declinaisons  Tache[]            @relation("Declinaisons")
  accordPar     User?              @relation("TacheAccord", fields: [accordParId], references: [id], onDelete: SetNull)
  assignations  TacheAssignation[]
  commentaires  CommentaireTache[]
  journal       Journal[]
  notifications Notification[]
  reunions      ReunionTache[]

  // Une déclinaison par périmètre cible. La clé est bornée par la tâche partagée,
  // elle-même rangée dans une activité (invariant 18).
  @@unique([origineId, perimetreId])
  @@index([editionId, perimetreId])
  @@index([editionId, echeance])
}

model TacheAssignation {
  id        String   @id @default(cuid())
  tacheId   String
  userId    String
  createdAt DateTime @default(now())

  tache Tache @relation(fields: [tacheId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tacheId, userId])
  @@index([userId])
}

// Commentaire d'une tâche (ADR 0029) : un texte daté et signé, écrit par une
// personne qui écrit dans le périmètre. Il vit en base seulement, et suit la tâche.
// La suppression d'un commentaire est définitive.
model CommentaireTache {
  id        String    @id @default(cuid())
  tacheId   String
  auteurId  String?
  texte     String    @db.Text
  // Le moment de la dernière modification du texte par son auteur.
  modifieLe DateTime?
  createdAt DateTime  @default(now())

  tache  Tache @relation(fields: [tacheId], references: [id], onDelete: Cascade)
  auteur User? @relation("CommentaireAuteur", fields: [auteurId], references: [id], onDelete: SetNull)

  @@index([tacheId, createdAt])
  @@index([auteurId])
}

// ── Agenda (ADR 0037) ─────────────────────────────────────────────────────────

// Jour, ou suite de jours, qu'un admin de l'activité place dans l'agenda d'une
// période : un dossier à déposer, une assemblée, une visite du site.
model DateCle {
  id             String    @id @default(cuid())
  organisationId String
  activiteId     String
  editionId      String
  titre          String    @db.VarChar(120)
  jour           DateTime  @db.Date
  // Dernier jour d'une suite de jours ; null pour un seul jour.
  jourFin        DateTime? @db.Date
  description    String?   @db.Text
  creeParId      String?
  // Compte les modifications. Une modification porte la version lue : le serveur
  // refuse d'écraser un changement fait entre-temps.
  version        Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  activite     Activite     @relation(fields: [activiteId], references: [id], onDelete: Restrict)
  edition      Edition      @relation(fields: [editionId], references: [id], onDelete: Restrict)
  creePar      User?        @relation("DateCleAuteur", fields: [creeParId], references: [id], onDelete: SetNull)

  @@index([editionId, jour])
  @@index([organisationId])
  @@index([activiteId])
  @@index([creeParId])
}

enum StatutReunion {
  PREVUE
  ANNULEE
}

// Les personnes convoquées à une réunion : tout le périmètre, toute l'équipe de
// l'activité, ou des personnes choisies dans l'équipe.
enum CibleConvocation {
  PERIMETRE
  EQUIPE
  CHOIX
}

enum ReponseConvocation {
  PRESENT
  ABSENT
  PEUT_ETRE
}

// Réunion de l'agenda global d'une activité (`perimetreId` nul) ou de l'agenda
// d'un périmètre, pour une période. Une réunion ne se supprime pas : elle
// s'annule, et l'annulation prévient les personnes convoquées.
model Reunion {
  id             String            @id @default(cuid())
  organisationId String
  activiteId     String
  editionId      String
  perimetreId    String?
  titre          String            @db.VarChar(200)
  // Instants en UTC. La saisie et l'affichage suivent le fuseau de l'organisation.
  debut          DateTime
  fin            DateTime
  lieu           String?           @db.VarChar(200)
  lienVisio      String?           @db.VarChar(500)
  description    String?           @db.Text
  statut         StatutReunion     @default(PREVUE)
  // Les personnes convoquées ; null sans convocation.
  cible          CibleConvocation?
  // Version iCalendar (SEQUENCE) : elle monte à chaque changement du titre, de
  // l'horaire, du lieu ou du lien, et à l'annulation.
  sequence       Int               @default(0)
  // Compte les modifications. Une modification porte la version lue.
  version        Int               @default(0)
  creeParId      String?
  annuleeLe      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organisation  Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  activite      Activite             @relation(fields: [activiteId], references: [id], onDelete: Restrict)
  edition       Edition              @relation(fields: [editionId], references: [id], onDelete: Restrict)
  perimetre     Perimetre?           @relation(fields: [perimetreId], references: [id], onDelete: Restrict)
  creePar       User?                @relation("ReunionAuteur", fields: [creeParId], references: [id], onDelete: SetNull)
  convocations  ConvocationReunion[]
  taches        ReunionTache[]
  notifications Notification[]
  sondage       Sondage?

  @@index([editionId, debut])
  @@index([perimetreId, debut])
  @@index([organisationId])
  @@index([activiteId])
  @@index([creeParId])
}

// Tâche liée à une réunion, vingt au plus par réunion : de la même période, et
// du même périmètre pour une réunion de périmètre. Le lien n'ouvre aucun droit.
model ReunionTache {
  id        String @id @default(cuid())
  reunionId String
  tacheId   String

  reunion Reunion @relation(fields: [reunionId], references: [id], onDelete: Cascade)
  tache   Tache   @relation(fields: [tacheId], references: [id], onDelete: Cascade)

  // Un lien par tâche, borné par la réunion (invariant 18).
  @@unique([reunionId, tacheId])
  @@index([tacheId])
}

// Convocation d'une personne de l'équipe à une réunion. Elle vise un compte,
// jamais une adresse. La personne répond dans l'application.
model ConvocationReunion {
  id              String              @id @default(cuid())
  reunionId       String
  userId          String
  reponse         ReponseConvocation?
  reponduLe       DateTime?
  // Dernier mail parti, et la version de la réunion qu'il portait.
  envoyeeLe       DateTime?
  sequenceEnvoyee Int?
  createdAt       DateTime            @default(now())

  reunion Reunion @relation(fields: [reunionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Une convocation par personne, bornée par la réunion (invariant 18).
  @@unique([reunionId, userId])
  @@index([userId])
}

// Ce que sert un abonnement : l'agenda d'une personne, ou l'agenda global d'une
// activité (ADR 0037).
// ── Programme du jour J (ADR 0040) ──────────────────────────────────────────────

// Endroit d'une activité : un terrain, un bassin, une salle. Il sert d'une période
// à l'autre.
model Lieu {
  id             String    @id @default(cuid())
  organisationId String
  activiteId     String
  nom            String    @db.VarChar(120)
  description    String?   @db.Text
  ordre          Int       @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  activite     Activite     @relation(fields: [activiteId], references: [id], onDelete: Restrict)
  sequences    Sequence[]

  @@index([activiteId, ordre])
  @@index([organisationId])
}

// Moment du programme d'une période : un titre, un horaire, un lieu et un
// périmètre facultatifs. Une séquence sans périmètre appartient à l'activité.
model Sequence {
  id                 String   @id @default(cuid())
  organisationId     String
  activiteId         String
  editionId          String
  perimetreId        String?
  lieuId             String?
  titre              String   @db.VarChar(200)
  // Instants en UTC. La saisie et l'affichage suivent le fuseau de l'organisation.
  debut              DateTime
  fin                DateTime
  description        String?  @db.Text
  // Nombre de renforts recherchés (ADR 0041). Null : la séquence ne cherche
  // personne et n'apparaît dans aucun appel.
  besoinBenevoles    Int?
  // Texte public pour les bénévoles : la mission, le rendez-vous, la tenue. La
  // description reste interne.
  consignesBenevoles String?  @db.Text
  // Compte les modifications. Une modification porte la version lue.
  version            Int      @default(0)
  creeParId          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organisation  Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  activite      Activite           @relation(fields: [activiteId], references: [id], onDelete: Restrict)
  edition       Edition            @relation(fields: [editionId], references: [id], onDelete: Restrict)
  perimetre     Perimetre?         @relation(fields: [perimetreId], references: [id], onDelete: Restrict)
  lieu          Lieu?              @relation(fields: [lieuId], references: [id], onDelete: SetNull)
  creePar       User?              @relation("SequenceAuteur", fields: [creeParId], references: [id], onDelete: SetNull)
  places        PlaceSequence[]
  appels        AppelBenevoles[]
  choix         ChoixCandidature[]
  notifications Notification[]

  @@index([editionId, debut])
  @@index([perimetreId])
  @@index([lieuId])
  @@index([organisationId])
  @@index([activiteId])
  @@index([creeParId])
}

enum RolePlace {
  RESPONSABLE
  RENFORT
}

// Une personne placée dans une séquence : un compte de l'équipe, ou une fiche
// bénévole, jamais les deux.
model PlaceSequence {
  id          String    @id @default(cuid())
  sequenceId  String
  userId      String?
  benevoleId  String?
  role        RolePlace @default(RENFORT)
  // Date à laquelle la personne a confirmé sa place (ADR 0041). Null : place à
  // confirmer. Une place saisie à la main, ou d'un membre, naît confirmée.
  confirmeeLe DateTime?
  createdAt   DateTime  @default(now())

  sequence Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  benevole Benevole? @relation(fields: [benevoleId], references: [id], onDelete: Cascade)

  // Une place par personne et par séquence, bornée par la séquence (invariant 18).
  @@unique([sequenceId, userId])
  @@unique([sequenceId, benevoleId])
  @@index([userId])
  @@index([benevoleId])
}

// Fiche d'une personne qui aide l'activité sans compte (ADR 0040). Elle ne donne
// aucun accès. Elle n'existe qu'avec l'accord de la personne, déclaré à la
// création, et vit en base seulement.
model Benevole {
  id                      String          @id @default(cuid())
  organisationId          String
  activiteId              String
  nom                     String          @db.VarChar(120)
  courriel                String?         @db.VarChar(254)
  telephone               String?         @db.VarChar(40)
  note                    String?         @db.Text
  // La date à laquelle la personne qui crée la fiche a déclaré l'accord.
  accordLe                DateTime
  // Saisie par l'équipe, ou née d'une candidature acceptée (ADR 0041).
  origine                 OrigineBenevole @default(SAISIE)
  // « Prévenir par mail » : avec une adresse, la fiche est joignable. Sa première
  // place envoie le lien, et ses places restent à confirmer.
  prevenirParMail         Boolean         @default(true)
  // Date à laquelle la personne a confirmé sa participation depuis son lien. Seule
  // une adresse confirmée reçoit d'autres mails que le premier.
  courrielConfirmeLe      DateTime?
  // Sel du lien de l'espace bénévole : le jeton se calcule à partir du secret du
  // serveur et de ce sel, et le serveur ne garde que son empreinte SHA-256.
  espaceSel               String?         @db.Char(43)
  espaceEmpreinte         String?         @db.Char(64)
  // Précisions de disponibilité de la personne, distinctes de la note de l'équipe :
  // « à partir de 18 h, tout poste sauf la photo » (ADR 0042).
  precisionsDisponibilite String?         @db.VarChar(600)
  // Import d'origine (ADR 0042) : sa source, et le périmètre d'un import de
  // périmètre, qui borne la lecture des plages dans la vue « Répartition ».
  sourceImport            String?         @db.VarChar(120)
  perimetreImportId       String?
  // Envoi du mail qui porte le lien, et relance unique.
  lienEnvoyeLe            DateTime?
  relanceLe               DateTime?
  creeParId               String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  organisation    Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  activite        Activite             @relation(fields: [activiteId], references: [id], onDelete: Restrict)
  creePar         User?                @relation("BenevoleAuteur", fields: [creeParId], references: [id], onDelete: SetNull)
  perimetreImport Perimetre?           @relation(fields: [perimetreImportId], references: [id], onDelete: SetNull)
  places          PlaceSequence[]
  pairesA         PaireDistincte[]     @relation("PaireDistincteA")
  pairesB         PaireDistincte[]     @relation("PaireDistincteB")
  candidatures    Candidature[]
  plages          PlageDisponibilite[]
  notifications   Notification[]

  // L'empreinte est unique dans son organisation (invariant 18) ; l'adresse de
  // l'espace ne porte pas l'organisation, d'où l'index sur l'empreinte seule.
  @@unique([organisationId, espaceEmpreinte])
  @@index([espaceEmpreinte])
  @@index([activiteId, nom])
  @@index([organisationId])
  @@index([creeParId])
  @@index([perimetreImportId])
}

enum OrigineBenevole {
  SAISIE
  CANDIDATURE
  // Née d'un import de liste (ADR 0042).
  IMPORT
}

// L'origine d'une candidature : la page publique d'un appel, ou un import de liste
// (ADR 0042).
enum OrigineCandidature {
  PUBLIC
  IMPORT
}

// ── Appels à bénévoles (ADR 0041) ───────────────────────────────────────────────

enum PorteeAppel {
  PERIODE
  PERIMETRE
  SEQUENCE
}

// Ouverture des candidatures sur une partie du programme d'une période, par une
// adresse publique secrète. Le jeton n'est jamais gardé : le serveur garde son
// empreinte SHA-256.
model AppelBenevoles {
  id                  String      @id @default(cuid())
  organisationId      String
  activiteId          String
  editionId           String
  portee              PorteeAppel
  // Le périmètre d'une portée « périmètre » ou « séquence ».
  perimetreId         String?
  // La séquence d'une portée « séquence ». Null après sa suppression : l'appel
  // est alors fermé.
  sequenceId          String?
  // Nom interne, pour reconnaître l'appel dans l'écran « Bénévoles ».
  nom                 String      @db.VarChar(120)
  introduction        String?     @db.Text
  ouvertLe            DateTime
  fermeLe             DateTime
  // Fermeture anticipée. Null : l'appel suit ses dates.
  fermeManuellementLe DateTime?
  // Le jeton se calcule à partir du secret du serveur et de ce sel : l'adresse se
  // recopie à tout moment. Un nouveau sel révoque l'ancienne adresse.
  sel                 String      @db.Char(43)
  empreinte           String      @db.Char(64)
  // Les derniers caractères du jeton, pour reconnaître l'adresse à l'écran.
  fin                 String      @db.VarChar(8)
  // Appel d'import (ADR 0042) : sans adresse publique et fermé, un par source dans
  // sa période. Son sel et son empreinte existent mais ne servent jamais.
  sansAdresse         Boolean     @default(false)
  sourceImport        String?     @db.VarChar(120)
  // Compte les modifications. Une modification porte la version lue.
  version             Int         @default(0)
  creeParId           String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  activite     Activite      @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  edition      Edition       @relation(fields: [editionId], references: [id], onDelete: Cascade)
  perimetre    Perimetre?    @relation(fields: [perimetreId], references: [id], onDelete: Restrict)
  sequence     Sequence?     @relation(fields: [sequenceId], references: [id], onDelete: SetNull)
  creePar      User?         @relation("AppelBenevolesAuteur", fields: [creeParId], references: [id], onDelete: SetNull)
  candidatures Candidature[]

  // L'empreinte est unique dans son organisation (invariant 18) ; l'adresse ne
  // porte pas l'organisation, d'où l'index sur l'empreinte seule.
  @@unique([organisationId, empreinte])
  @@unique([editionId, sourceImport])
  @@index([empreinte])
  @@index([editionId])
  @@index([activiteId])
  @@index([perimetreId])
  @@index([sequenceId])
  @@index([creeParId])
}

enum StatutCandidature {
  EN_ATTENTE
  TRAITEE
  RETIREE
}

// Dépôt d'une personne sur un appel à bénévoles. Il porte des données d'une
// personne sans compte : il vit en base seulement, et la purge le supprime à
// l'archivage de sa période.
model Candidature {
  id                      String             @id @default(cuid())
  organisationId          String
  activiteId              String
  editionId               String
  appelId                 String
  statut                  StatutCandidature  @default(EN_ATTENTE)
  nom                     String             @db.VarChar(120)
  // Obligatoire pour un dépôt en ligne.
  courriel                String?            @db.VarChar(254)
  // L'adresse tant que la candidature attend, puis null : la contrainte d'unicité
  // garde une seule candidature en attente par adresse et par appel.
  courrielEnAttente       String?            @db.VarChar(254)
  telephone               String?            @db.VarChar(40)
  message                 String?            @db.VarChar(600)
  precisionsDisponibilite String?            @db.VarChar(600)
  // La personne aide là où il manque du monde, sans choisir de séquence.
  ouAilleurs              Boolean            @default(false)
  // La date à laquelle la personne a donné son accord, en déposant.
  accordLe                DateTime
  // Origine (ADR 0042). Une candidature importée garde sa source et l'identifiant
  // de sa ligne dans l'outil d'origine, qui rend l'import rejouable.
  origine                 OrigineCandidature @default(PUBLIC)
  sourceImport            String?            @db.VarChar(120)
  refExterne              String?            @db.VarChar(120)
  // La fiche créée ou rattachée par la première acceptation.
  benevoleId              String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  activite     Activite             @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  edition      Edition              @relation(fields: [editionId], references: [id], onDelete: Cascade)
  appel        AppelBenevoles       @relation(fields: [appelId], references: [id], onDelete: Cascade)
  benevole     Benevole?            @relation(fields: [benevoleId], references: [id], onDelete: SetNull)
  choix        ChoixCandidature[]
  plages       PlageDisponibilite[]

  @@unique([appelId, courrielEnAttente])
  @@unique([appelId, refExterne])
  @@index([appelId, statut, createdAt])
  @@index([editionId, statut])
  @@index([organisationId])
  @@index([activiteId])
  @@index([benevoleId])
}

enum StatutChoix {
  EN_ATTENTE
  LISTE_ATTENTE
  ACCEPTE
  REFUSE
}

// Une séquence choisie dans une candidature. Son statut se fixe au dépôt (en
// attente ou en liste d'attente), puis par la décision de l'équipe.
model ChoixCandidature {
  id            String      @id @default(cuid())
  candidatureId String
  sequenceId    String
  statut        StatutChoix
  traiteParId   String?
  traiteLe      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  candidature Candidature @relation(fields: [candidatureId], references: [id], onDelete: Cascade)
  sequence    Sequence    @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  traitePar   User?       @relation("ChoixCandidatureTraitement", fields: [traiteParId], references: [id], onDelete: SetNull)

  // Un choix par séquence, borné par la candidature (invariant 18).
  @@unique([candidatureId, sequenceId])
  @@index([sequenceId, statut])
  @@index([traiteParId])
}

// Intervalle où une personne peut aider pendant une période. Il appartient soit à
// une candidature, soit à une fiche bénévole, jamais aux deux : le code porte
// cette règle, car une contrainte CHECK sur une clé étrangère en cascade échoue
// sous MariaDB (ADR 0040).
model PlageDisponibilite {
  id            String   @id @default(cuid())
  editionId     String
  candidatureId String?
  benevoleId    String?
  // Instants en UTC. La saisie et l'affichage suivent le fuseau de l'organisation.
  debut         DateTime
  fin           DateTime
  createdAt     DateTime @default(now())

  edition     Edition      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  candidature Candidature? @relation(fields: [candidatureId], references: [id], onDelete: Cascade)
  benevole    Benevole?    @relation(fields: [benevoleId], references: [id], onDelete: Cascade)

  @@index([editionId, debut])
  @@index([candidatureId])
  @@index([benevoleId, editionId])
}

enum StatutSondage {
  OUVERT
  CLOS
}

enum ChoixSondage {
  OUI
  SI_BESOIN
  NON
}

// Sondage de dates pour une réunion à venir (ADR 0037), dans l'agenda global
// d'une activité ou dans l'agenda d'un périmètre. Les personnes visées répondent à
// chaque créneau ; une personne qui écrit dans l'agenda le clôt sur un créneau,
// puis crée la réunion.
model Sondage {
  id              String           @id @default(cuid())
  organisationId  String
  activiteId      String
  editionId       String
  perimetreId     String?
  titre           String           @db.VarChar(200)
  description     String?          @db.Text
  cible           CibleConvocation
  statut          StatutSondage    @default(OUVERT)
  // Le créneau retenu à la clôture, et la réunion créée depuis le sondage.
  creneauRetenuId String?          @unique
  reunionId       String?          @unique
  // Compte les modifications. Une modification porte la version lue.
  version         Int              @default(0)
  creeParId       String?
  closLe          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organisation  Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  activite      Activite             @relation(fields: [activiteId], references: [id], onDelete: Restrict)
  edition       Edition              @relation(fields: [editionId], references: [id], onDelete: Restrict)
  perimetre     Perimetre?           @relation(fields: [perimetreId], references: [id], onDelete: Restrict)
  creePar       User?                @relation("SondageAuteur", fields: [creeParId], references: [id], onDelete: SetNull)
  creneauRetenu CreneauSondage?      @relation("CreneauRetenu", fields: [creneauRetenuId], references: [id], onDelete: SetNull)
  reunion       Reunion?             @relation(fields: [reunionId], references: [id], onDelete: SetNull)
  creneaux      CreneauSondage[]     @relation("CreneauxDuSondage")
  participants  ParticipantSondage[]
  notifications Notification[]

  @@index([editionId])
  @@index([perimetreId])
  @@index([organisationId])
  @@index([activiteId])
  @@index([creeParId])
}

// Un créneau proposé : un jour, avec un horaire facultatif dans le fuseau de
// l'organisation (HH:MM).
model CreneauSondage {
  id         String   @id @default(cuid())
  sondageId  String
  jour       DateTime @db.Date
  heureDebut String?  @db.VarChar(5)
  heureFin   String?  @db.VarChar(5)
  ordre      Int      @default(0)

  sondage   Sondage          @relation("CreneauxDuSondage", fields: [sondageId], references: [id], onDelete: Cascade)
  retenuPar Sondage?         @relation("CreneauRetenu")
  reponses  ReponseSondage[]

  @@index([sondageId, ordre])
}

// Une personne visée par un sondage, fixée à son ouverture.
model ParticipantSondage {
  id        String   @id @default(cuid())
  sondageId String
  userId    String
  createdAt DateTime @default(now())

  sondage Sondage @relation(fields: [sondageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Une participation par personne, bornée par le sondage (invariant 18).
  @@unique([sondageId, userId])
  @@index([userId])
}

// La réponse d'une personne à un créneau.
model ReponseSondage {
  id        String       @id @default(cuid())
  creneauId String
  userId    String
  choix     ChoixSondage
  updatedAt DateTime     @updatedAt

  creneau CreneauSondage @relation(fields: [creneauId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Une réponse par personne et par créneau, bornée par le créneau (invariant 18).
  @@unique([creneauId, userId])
  @@index([userId])
}

enum SorteAbonnement {
  PERSONNEL
  ACTIVITE
}

// Adresse secrète qui sert un agenda au format iCalendar, en lecture seule
// (ADR 0037). Le jeton de l'adresse ne se garde pas : seule son empreinte SHA-256
// le désigne. Une personne a au plus un abonnement actif par organisation, une
// activité aussi : le code révoque l'ancien avant d'en créer un nouveau.
model AbonnementAgenda {
  id               String          @id @default(cuid())
  organisationId   String
  sorte            SorteAbonnement
  // La personne d'un abonnement personnel.
  userId           String?
  // L'activité d'un abonnement d'activité.
  activiteId       String?
  empreinte        String          @db.Char(64)
  // Les derniers caractères du jeton, pour reconnaître l'adresse à l'écran.
  fin              String          @db.VarChar(8)
  // Abonnement personnel : les périmètres choisis. Null : tous les périmètres
  // que la personne lit.
  perimetreIds     Json?
  // Abonnement personnel : l'agenda global des activités, et les échéances des
  // tâches assignées à la personne.
  inclureGlobal    Boolean         @default(true)
  inclureEcheances Boolean         @default(false)
  // Dernière lecture par un agenda, posée au plus une fois par heure.
  dernierAccesLe   DateTime?
  revoqueLe        DateTime?
  creeParId        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User?        @relation("AbonnementPersonne", fields: [userId], references: [id], onDelete: Cascade)
  activite     Activite?    @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  creePar      User?        @relation("AbonnementAuteur", fields: [creeParId], references: [id], onDelete: SetNull)

  // L'empreinte est unique dans son organisation (invariant 18) ; l'adresse ne
  // porte pas l'organisation, d'où l'index sur l'empreinte seule.
  @@unique([organisationId, empreinte])
  @@index([empreinte])
  @@index([userId])
  @@index([activiteId])
  @@index([creeParId])
}

enum TypeJournal {
  TACHE_CREEE
  TACHE_MODIFIEE
  TACHE_ASSIGNEE
  TACHE_DESASSIGNEE
  TACHE_STATUT
  FICHE_CREEE
  FICHE_MODIFIEE
  // Accord d'un périmètre cible sur une déclinaison (ADR 0026) : la tâche et le
  // périmètre de la ligne sont ceux de la déclinaison.
  DECLINAISON_PROPOSEE
  DECLINAISON_ACCEPTEE
  DECLINAISON_REFUSEE
  DECLINAISON_IMPOSEE
  // Une fiche connexe masquée, puis affichée de nouveau, par un périmètre cible
  // (ADR 0039) : le périmètre de la ligne est le périmètre cible.
  FICHE_CONNEXE_MASQUEE
  FICHE_CONNEXE_AFFICHEE
}

// Journal : qui a fait quoi, et quand. Il alimente les notifications et le score
// de participation. Nommé Activite jusqu'à l'ADR 0008, qui donne ce mot aux activités.
model Journal {
  id            String       @id @default(cuid())
  type          TypeJournal
  acteurId      String
  // Nuls pour une action sur une fiche commune, qui n'appartient à aucun périmètre ni édition.
  editionId     String?
  perimetreId   String?
  tacheId       String?
  ficheId       String?
  // Pour TACHE_ASSIGNEE et TACHE_DESASSIGNEE : la personne concernée.
  personneId    String?
  // Pour TACHE_STATUT : le nouveau statut.
  statut        StatutTache?
  realiseeParId String?
  createdAt     DateTime     @default(now())

  acteur    User       @relation("JournalActeur", fields: [acteurId], references: [id], onDelete: Restrict)
  edition   Edition?   @relation(fields: [editionId], references: [id], onDelete: Restrict)
  perimetre Perimetre? @relation(fields: [perimetreId], references: [id], onDelete: Restrict)
  tache     Tache?     @relation(fields: [tacheId], references: [id], onDelete: SetNull)
  fiche     Fiche?     @relation(fields: [ficheId], references: [id], onDelete: SetNull)

  @@index([acteurId, createdAt])
  @@index([editionId, perimetreId, createdAt])
}

// ── Fiches méthode ───────────────────────────────────────────────────────────

// GIT : dépôt de contenu. APP : écrite dans l'application. ESPACE_FICHIERS :
// importée de l'espace de fichiers de l'organisation (ADR 0038).
enum SourceFiche {
  GIT
  APP
  ESPACE_FICHIERS
}

// Fiche « comment faire » d'un périmètre, ou fiche commune (perimetreId null).
// Son contenu vit dans ses versions ; la fiche pointe vers la version courante.
model Fiche {
  id                String    @id @default(cuid())
  organisationId    String
  activiteId        String
  slug              String
  perimetreId       String?
  versionCouranteId String?   @unique
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organisation    Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  activite        Activite              @relation(fields: [activiteId], references: [id], onDelete: Restrict)
  perimetre       Perimetre?            @relation(fields: [perimetreId], references: [id], onDelete: Restrict)
  versionCourante FicheVersion?         @relation("FicheVersionCourante", fields: [versionCouranteId], references: [id], onDelete: SetNull)
  versions        FicheVersion[]        @relation("FicheVersions")
  taches          Tache[]
  journal         Journal[]
  notifications   Notification[]
  // Liste « Concerne aussi » (ADR 0039) : des périmètres et des groupes de l'activité.
  connexes        FicheConnexe[]
  groupesConnexes FicheGroupeConnexe[]
  masquages       FicheConnexeMasquee[]
  ressources      RessourceFiche[]
  exportCloud     FicheExportee?

  @@unique([organisationId, slug])
  @@index([perimetreId])
  @@index([organisationId])
  @@index([activiteId])
}

// Une version ne se modifie ni ne se supprime. Restaurer une version en crée une nouvelle.
model FicheVersion {
  id        String      @id @default(cuid())
  ficheId   String
  titre     String
  contenu   String      @db.MediumText
  // SHA-256 du titre et du contenu : l'import compare les empreintes.
  empreinte String      @db.Char(64)
  source    SourceFiche
  resume    String?
  auteurId  String?
  createdAt DateTime    @default(now())

  fiche         Fiche  @relation("FicheVersions", fields: [ficheId], references: [id], onDelete: Cascade)
  ficheCourante Fiche? @relation("FicheVersionCourante")
  auteur        User?  @relation(fields: [auteurId], references: [id], onDelete: SetNull)

  @@index([ficheId, createdAt])
}

// ── Fiches connexes (ADR 0039) ───────────────────────────────────────────────
// Une fiche de périmètre se lit, sans s'y modifier, dans d'autres périmètres de son
// activité : ceux de sa liste « Concerne aussi », ceux des groupes de cette liste, et
// ceux d'une déclinaison acceptée qui la cite. Chaque clé unique est bornée par la
// fiche (invariant 18).

// Un périmètre de la liste « Concerne aussi ». `ajouteeParId` est nul pour une ligne
// venue du contenu.
model FicheConnexe {
  id           String   @id @default(cuid())
  ficheId      String
  perimetreId  String
  ajouteeParId String?
  ajouteeLe    DateTime @default(now())

  fiche      Fiche     @relation(fields: [ficheId], references: [id], onDelete: Cascade)
  perimetre  Perimetre @relation(fields: [perimetreId], references: [id], onDelete: Cascade)
  ajouteePar User?     @relation("FicheConnexeAuteur", fields: [ajouteeParId], references: [id], onDelete: SetNull)

  @@unique([ficheId, perimetreId])
  @@index([perimetreId])
}

// Un groupe de la liste « Concerne aussi », désigné par sa clé dans l'activité de la
// fiche. Il concerne aussi les périmètres qui rejoignent le groupe plus tard.
model FicheGroupeConnexe {
  id          String   @id @default(cuid())
  ficheId     String
  groupe      String
  ajouteParId String?
  ajouteLe    DateTime @default(now())

  fiche     Fiche @relation(fields: [ficheId], references: [id], onDelete: Cascade)
  ajoutePar User? @relation("FicheGroupeConnexeAuteur", fields: [ajouteParId], references: [id], onDelete: SetNull)

  @@unique([ficheId, groupe])
}

// Une fiche connexe masquée par un périmètre cible : elle quitte sa liste « Fiches
// connexes » et reste lisible par son lien. Le masquage vaut quel que soit le chemin
// du partage. Il vit en base seulement, jamais dans le contenu.
model FicheConnexeMasquee {
  id           String   @id @default(cuid())
  ficheId      String
  perimetreId  String
  masqueeParId String?
  masqueeLe    DateTime @default(now())

  fiche      Fiche     @relation(fields: [ficheId], references: [id], onDelete: Cascade)
  perimetre  Perimetre @relation(fields: [perimetreId], references: [id], onDelete: Cascade)
  masqueePar User?     @relation("FicheConnexeMasqueePar", fields: [masqueeParId], references: [id], onDelete: SetNull)

  @@unique([ficheId, perimetreId])
  @@index([perimetreId])
}

// Droit d'écrire les fiches, accordé par un admin : pour un périmètre, ou pour
// toutes les fiches de l'organisation (perimetreId null), fiches communes comprises.
// La clé d'organisation borne le droit global à une organisation (ADR 0008).
model DroitRedaction {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  perimetreId    String?
  accordeParId   String?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         User         @relation("DroitRedactionPersonne", fields: [userId], references: [id], onDelete: Cascade)
  perimetre    Perimetre?   @relation(fields: [perimetreId], references: [id], onDelete: Cascade)
  accordePar   User?        @relation("DroitRedactionAuteur", fields: [accordeParId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organisationId])
}

// ── Notifications ────────────────────────────────────────────────────────────

enum TypeNotification {
  TACHE_CREEE
  TACHE_MODIFIEE
  TACHE_ASSIGNEE
  TACHE_DESASSIGNEE
  ECHEANCE_PROCHE
  TACHE_EN_RETARD
  DEMANDE_RECUE
  // Activité d'un périmètre, pour ses autres référentes et référents : dans
  // l'application seulement, jamais par mail immédiat.
  TACHE_STATUT
  FICHE_CREEE
  FICHE_MODIFIEE
  // Déclinaison d'une tâche partagée (ADR 0026), dans l'application seulement :
  // proposée au périmètre cible, puis acceptée ou refusée pour le périmètre
  // d'origine. `tacheId` désigne la déclinaison.
  DECLINAISON_PROPOSEE
  DECLINAISON_ACCEPTEE
  DECLINAISON_REFUSEE
  // Commentaire écrit sur une tâche (ADR 0029). La notification ne porte pas le
  // texte : elle nomme l'auteur et la tâche.
  TACHE_COMMENTEE
  // Une personne a accepté l'invitation de l'organisation (ADR 0030). `acteurId`
  // la désigne ; `activiteId` porte l'activité de l'invitation, s'il y en a une.
  INVITATION_ACCEPTEE
  // Notifications d'admin (ADR 0033). `acteurId` désigne l'admin qui a agi,
  // `personneId` la personne concernée, `activiteId` et `perimetreId` le rangement.
  AFFECTATION_AJOUTEE
  AFFECTATION_RETIREE
  // Une personne a formulé un souhait dans « Tous les périmètres » : elle est l'acteur.
  SOUHAIT_FORMULE
  // Une demande traitée par un autre admin. Elle ne nomme pas la personne (ADR 0015).
  DEMANDE_ACCEPTEE
  DEMANDE_REFUSEE
  ADMIN_ACTIVITE_NOMME
  ADMIN_ACTIVITE_RETIRE
  ADMIN_ORGANISATION_NOMME
  ADMIN_ORGANISATION_RETIRE
  PERSONNE_ARCHIVEE
  PERSONNE_RETABLIE
  // La place d'une personne dans l'équipe a changé : elle accompagne le mail
  // d'équipe (ADR 0012), pour la personne concernée.
  PLACE_MODIFIEE
  // Réunion de l'agenda (ADR 0037), pour chaque personne convoquée : convocation,
  // modification de l'horaire, du lieu ou du lien, annulation. `reunionId` la désigne.
  REUNION_CONVOQUEE
  REUNION_MODIFIEE
  REUNION_ANNULEE
  // Un sondage de dates vise la personne (ADR 0037). `sondageId` le désigne.
  SONDAGE_OUVERT
  // Une fiche d'un autre périmètre concerne aussi celui-ci (ADR 0039), dans
  // l'application seulement. `perimetreId` désigne le périmètre cible.
  FICHE_CONNEXE
  // Candidature reçue sur un appel à bénévoles (ADR 0041), pour les personnes qui
  // peuvent la traiter. `activiteId` désigne l'activité ; aucun nom n'est gardé.
  CANDIDATURE_RECUE
  // Une ou un bénévole s'est retiré d'une séquence depuis son espace (ADR 0041).
  BENEVOLE_RETIRE
  // Des propositions d'accès chez le fournisseur attendent un admin de
  // l'organisation (ADR 0044), une fois par jour au plus.
  ACCES_FOURNISSEUR_A_VALIDER
}

// À quel titre une personne reçoit une notification (ADR 0033). Le niveau
// `REFERENT` reste dans la cloche ; les niveaux d'admin ont leur écran.
enum NiveauNotification {
  REFERENT
  ADMIN_ACTIVITE
  ADMIN_ORGANISATION
}

// Une notification ne stocke que des identifiants : le texte se compose à la lecture,
// à partir des titres et des noms à jour.
model Notification {
  id             String             @id @default(cuid())
  organisationId String
  userId         String
  type           TypeNotification
  niveau         NiveauNotification @default(REFERENT)
  acteurId       String?
  tacheId        String?
  perimetreId    String?
  // La période d'une notification d'admin liée à une période (affectation, souhait),
  // pour la nommer quand l'activité en a plusieurs d'ouvertes (ADR 0033).
  editionId      String?
  // Pour DEMANDE_RECUE : l'activité dont la file de demandes attend une revue.
  activiteId     String?
  // Pour TACHE_ASSIGNEE et TACHE_DESASSIGNEE : la personne concernée.
  personneId     String?
  // Pour ECHEANCE_PROCHE : le nombre de jours avant l'échéance.
  jours          Int?
  // Pour FICHE_CREEE et FICHE_MODIFIEE : la fiche concernée.
  ficheId        String?
  // Pour TACHE_STATUT : le nouveau statut. Un passage à « faite » ne garde pas son
  // auteur : qui a coché reste réservé à la personne qui a coché et aux admins.
  statut         StatutTache?
  // Pour les notifications d'une réunion (ADR 0037).
  reunionId      String?
  // Pour les notifications d'un sondage de dates (ADR 0037).
  sondageId      String?
  // Pour BENEVOLE_RETIRE (ADR 0041) : la séquence quittée, et la fiche, tant
  // qu'elle existe.
  sequenceId     String?
  benevoleId     String?
  // Empêche de créer deux fois le même rappel (type, tâche, personne, échéance).
  cle            String?            @unique
  lueLe          DateTime?
  // Date d'envoi du mail immédiat, s'il y en a eu un.
  envoyeeLe      DateTime?
  // Date d'inclusion dans un résumé par mail.
  resumeeLe      DateTime?
  createdAt      DateTime           @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         User         @relation("NotificationDestinataire", fields: [userId], references: [id], onDelete: Cascade)
  tache        Tache?       @relation(fields: [tacheId], references: [id], onDelete: Cascade)
  activite     Activite?    @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  fiche        Fiche?       @relation(fields: [ficheId], references: [id], onDelete: Cascade)
  reunion      Reunion?     @relation(fields: [reunionId], references: [id], onDelete: Cascade)
  sondage      Sondage?     @relation(fields: [sondageId], references: [id], onDelete: Cascade)
  sequence     Sequence?    @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  benevole     Benevole?    @relation(fields: [benevoleId], references: [id], onDelete: SetNull)

  @@index([userId, lueLe, createdAt])
  @@index([sequenceId])
  @@index([benevoleId])
  @@index([reunionId])
  @@index([sondageId])
  @@index([userId, resumeeLe])
  @@index([organisationId])
  @@index([userId, organisationId, niveau, lueLe])
}

enum FrequenceResume {
  QUOTIDIEN
  HEBDOMADAIRE
  AUCUN
}

// Préférences d'une personne. Sans ligne, les valeurs par défaut s'appliquent.
model PreferenceNotification {
  userId               String          @id
  organisationId       String
  frequenceResume      FrequenceResume @default(HEBDOMADAIRE)
  // Mail immédiat quand une autre personne modifie une de vos tâches.
  mailModification     Boolean         @default(true)
  // Mail immédiat pour les échéances à 7 jours, à 1 jour, et les retards.
  mailEcheance         Boolean         @default(true)
  // Mail regroupé par heure quand une activité que la personne administre reçoit
  // des demandes pour rejoindre son équipe (ADR 0016).
  mailDemandes         Boolean         @default(true)
  // Notification dans l'application quand une autre personne agit sur une tâche ou
  // une fiche d'un périmètre où la personne est affectée.
  applicationPerimetre Boolean         @default(true)
  // Notifications push (ADR 0024), par famille. Elles ne partent que vers les
  // appareils où la personne les a activées (AbonnementPush).
  pushTaches           Boolean         @default(true)
  pushEcheances        Boolean         @default(true)
  pushDemandes         Boolean         @default(true)
  dernierResumeLe      DateTime?
  // Date du dernier résumé envoyé pour chaque organisation : { [organisationId]: ISO }.
  // Une personne membre de plusieurs organisations reçoit le résumé de chacune (ADR 0008).
  derniersResumes      Json?
  updatedAt            DateTime        @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

// Préférences de notification d'une personne dans une organisation (ADR 0032 et
// 0033). Sans ligne, les valeurs par défaut s'appliquent. Elles remplacent
// `PreferenceNotification`, gardée sans écriture pour un retour à une version
// antérieure.
model PreferenceOrganisation {
  userId               String
  organisationId       String
  frequenceResume      FrequenceResume @default(HEBDOMADAIRE)
  // Vos tâches et vos périmètres.
  mailModification     Boolean         @default(true)
  mailEcheance         Boolean         @default(true)
  applicationPerimetre Boolean         @default(true)
  pushTaches           Boolean         @default(true)
  pushEcheances        Boolean         @default(true)
  // Vos rôles d'admin : demandes et invitations.
  mailDemandes         Boolean         @default(true)
  pushDemandes         Boolean         @default(true)
  // Vos rôles d'admin : équipe (ADR 0033).
  applicationEquipe    Boolean         @default(true)
  pushEquipe           Boolean         @default(false)
  // La section « Pour vos rôles d'admin » du résumé.
  resumeAdmin          Boolean         @default(true)
  // Vos réunions : convocation, modification, annulation (ADR 0037).
  pushAgenda           Boolean         @default(true)
  dernierResumeLe      DateTime?
  updatedAt            DateTime        @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, organisationId])
  @@index([organisationId])
}

// Abonnement d'un appareil aux notifications push (ADR 0024). L'adresse vient du
// service de push du navigateur ; son empreinte SHA-256 la désigne, car une
// adresse dépasse la longueur d'un index. Un abonnement appartient à une
// personne, pas à une organisation, comme ses préférences.
model AbonnementPush {
  id        String   @id @default(cuid())
  userId    String
  empreinte String   @db.Char(64)
  adresse   String   @db.Text
  // Clés de chiffrement fournies par le navigateur : le message est chiffré pour
  // cet appareil, et le service de push ne peut pas le lire.
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  // Libellé d'appareil, déduit de l'agent de navigation : « iPhone », « Android »…
  appareil  String   @db.VarChar(60)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, empreinte])
}

// ── Espace de fichiers (ADR 0038) ────────────────────────────────────────────

enum FournisseurFichiers {
  SHAREPOINT
  GOOGLE_DRIVE
  DROPBOX
  NEXTCLOUD
}

// COMPTE : un admin se connecte avec son compte, par OAuth ; le secret gardé est
// son jeton de rafraîchissement. COMPTE_SERVICE : l'organisation dépose la clé
// d'un compte de service et partage ses dossiers avec lui ; le secret gardé est
// cette clé (Google Drive).
enum MethodeConnexionFichiers {
  COMPTE
  COMPTE_SERVICE
}

// A_RECONNECTER : le fournisseur a refusé le jeton. Un admin de l'organisation
// reconnecte l'espace de fichiers ; les dossiers liés attendent sans changer.
enum EtatConnexionFichiers {
  ACTIVE
  A_RECONNECTER
}

// Ce que la connexion permet en plus des fichiers (ADR 0044) : lire l'annuaire et
// les droits, puis appliquer les propositions d'accès.
enum PorteeConnexionFichiers {
  FICHIERS
  ANNUAIRE
  GESTION
}

// Les personnes qu'un dossier lié attend chez le fournisseur (ADR 0044).
enum AttendusDossier {
  MEMBRES
  CONTACTS_PRINCIPAUX
}

// Comment Relaytour propose les accès d'un dossier lié chez le fournisseur
// (ADR 0044) : rien, un partage du dossier, ou l'entrée dans un groupe.
enum AccesFournisseurDossier {
  AUCUN
  PARTAGE
  GROUPE
}

enum RoleFournisseur {
  LECTURE
  ECRITURE
}

enum ActionProposition {
  AJOUTER
  RETIRER
}

enum EtatProposition {
  EN_ATTENTE
  // Un admin, ou un ajout automatique, l'applique en ce moment : une seconde
  // application de la même proposition est refusée.
  EN_COURS
  APPLIQUEE
  ECARTEE
  ECHEC
}

// Un compte chez le fournisseur, rapproché d'une personne par son adresse.
enum EtatCompteFournisseur {
  TROUVE
  INVITE
  ABSENT
}

// L'état d'une personne face aux droits d'un dossier lié chez le fournisseur.
enum EtatAccesFournisseur {
  A_ACCES
  SANS_COMPTE
  SANS_ACCES
  INCONNU
  EN_TROP
}

// Espace de fichiers d'une organisation : une connexion au plus. Relaytour agit
// avec les droits du compte connecté. Le secret (jeton de rafraîchissement ou clé
// de compte de service) est chiffré (lib/chiffrement.ts) et ne sort jamais du
// serveur, ni par l'API ni dans l'export.
model ConnexionFichiers {
  id                String                   @id @default(cuid())
  organisationId    String                   @unique
  fournisseur       FournisseurFichiers
  methode           MethodeConnexionFichiers @default(COMPTE)
  // Nom affiché du compte connecté chez le fournisseur, lu par les admins de
  // l'organisation. Jamais l'adresse d'une personne ; pour un compte de service,
  // son adresse technique, avec laquelle l'organisation partage ses dossiers.
  compte            String                   @db.VarChar(255)
  jeton             String                   @db.Text
  etat              EtatConnexionFichiers    @default(ACTIVE)
  connecteParId     String?
  // Dossier d'export des fiches (ADR 0038), créé par Relaytour dans le dossier
  // choisi par un admin. `exportAncetres` porte les identifiants de ses dossiers
  // parents et le sien : aucun d'eux ne se lie à un périmètre.
  exportEmplacement String?                  @db.VarChar(255)
  exportElement     String?                  @db.VarChar(255)
  exportNom         String?                  @db.VarChar(1024)
  exportAncetres    Json?
  // Résultat du dernier export : fiches écrites, inchangées, supprimées,
  // refusées, modifiées à la main dans l'espace de fichiers, erreur.
  exportRapport     Json?
  exportLe          DateTime?
  // Autorisations accordées par l'admin au-delà des fichiers (ADR 0044).
  portee            PorteeConnexionFichiers  @default(FICHIERS)
  // Dernière vérification des accès, et son erreur éventuelle.
  accesVerifieLe    DateTime?
  accesErreur       String?                  @db.VarChar(255)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  connectePar  User?        @relation(fields: [connecteParId], references: [id], onDelete: SetNull)
}

// Le compte d'une personne chez le fournisseur connecté (ADR 0044). Relaytour le
// cherche par l'adresse de la personne, ou par l'adresse qu'un admin saisit pour
// elle. Il n'entre jamais dans le dépôt de l'organisation.
model CompteFournisseur {
  id             String                @id @default(cuid())
  organisationId String
  userId         String
  fournisseur    FournisseurFichiers
  // Adresse saisie par un admin, quand la personne utilise un autre compte.
  adresseSaisie  String?               @db.VarChar(320)
  etat           EtatCompteFournisseur @default(ABSENT)
  // Identifiant du compte chez le fournisseur, quand il est trouvé.
  identifiant    String?               @db.VarChar(255)
  verifieLe      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, fournisseur, userId])
  @@index([userId])
}

// Un ajout ou un retrait d'accès chez le fournisseur, que Relaytour propose et
// qu'un admin de l'organisation applique ou écarte (ADR 0044). Une seule
// proposition en attente par dossier, personne et action.
model PropositionAcces {
  id             String            @id @default(cuid())
  organisationId String
  dossierLieId   String
  userId         String
  action         ActionProposition
  etat           EtatProposition   @default(EN_ATTENTE)
  erreur         String?           @db.VarChar(255)
  creeLe         DateTime          @default(now())
  traiteeParId   String?
  traiteeLe      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  dossierLie   DossierLie   @relation(fields: [dossierLieId], references: [id], onDelete: Cascade)
  user         User         @relation("PropositionPersonne", fields: [userId], references: [id], onDelete: Cascade)
  traiteePar   User?        @relation("PropositionTraitee", fields: [traiteeParId], references: [id], onDelete: SetNull)

  @@index([organisationId, dossierLieId, etat])
  @@index([userId])
}

// Un droit que Relaytour a créé chez le fournisseur (ADR 0044) : un partage du
// dossier, ou l'entrée dans un groupe. Relaytour ne retire que ces droits-là.
model PermissionCreee {
  id             String           @id @default(cuid())
  organisationId String
  dossierLieId   String
  userId         String
  // Identifiant du droit chez le fournisseur, ou « groupe: » suivi du groupe.
  identifiant    String           @db.VarChar(255)
  // Ce que Relaytour a créé : le rôle d'un partage, l'adresse qui l'a reçu, et le
  // compte du fournisseur (pour un groupe, le compte qui y est entré). Relaytour
  // ne retire le droit que s'il les retrouve tels quels chez le fournisseur.
  role           RoleFournisseur?
  adresse        String?          @db.VarChar(320)
  compte         String?          @db.VarChar(255)
  creeLe         DateTime         @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  dossierLie   DossierLie   @relation(fields: [dossierLieId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dossierLieId, userId])
  @@index([organisationId])
  @@index([userId])
}

// L'état d'une personne face aux droits d'un dossier lié, à la dernière
// vérification (ADR 0044). Chaque vérification remplace les lignes du dossier. Un
// accès en trop garde un nom, jamais d'adresse.
model EtatAccesDossier {
  id             String               @id @default(cuid())
  organisationId String
  dossierLieId   String
  userId         String?
  // Nom affiché d'un accès en trop, qui n'est pas une personne de Relaytour.
  nom            String?              @db.VarChar(255)
  etat           EtatAccesFournisseur
  // Comment la personne a accès : « direct », « domaine », ou le nom du groupe.
  via            String?              @db.VarChar(255)
  verifieLe      DateTime             @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  dossierLie   DossierLie   @relation(fields: [dossierLieId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organisationId, dossierLieId])
  @@index([userId])
}

// Dossier de l'espace de fichiers lié à un périmètre, ou à toute l'activité
// (perimetreId nul). Il se lit comme les fiches du même périmètre. Le lien survit
// à une déconnexion : il attend une nouvelle connexion du même fournisseur.
model DossierLie {
  id                    String                  @id @default(cuid())
  organisationId        String
  activiteId            String
  // Ancien périmètre unique (ADR 0038), gardé pour une version antérieure : il
  // porte le premier périmètre des lecteurs, ou rien pour toute l'activité. Les
  // droits se lisent dans `touteActivite` et les deux listes (ADR 0043).
  perimetreId           String?
  // Vrai : le dossier sert toute l'activité, et les listes restent vides.
  touteActivite         Boolean                 @default(false)
  // Les personnes que le dossier attend chez le fournisseur (ADR 0044).
  attendus              AttendusDossier         @default(MEMBRES)
  // Comment Relaytour propose leurs accès, et avec quel rôle (ADR 0044). Le
  // groupe se choisit parmi ceux qui ont déjà un droit sur le dossier.
  accesFournisseur      AccesFournisseurDossier @default(AUCUN)
  groupeFournisseurId   String?                 @db.VarChar(255)
  groupeFournisseurNom  String?                 @db.VarChar(255)
  roleFournisseur       RoleFournisseur         @default(LECTURE)
  // Vrai : les ajouts s'appliquent sans attendre un admin. Un retrait attend
  // toujours un admin.
  ajoutsAutomatiques    Boolean                 @default(false)
  // Vrai : le fournisseur envoie son mail d'invitation lors d'un partage.
  invitationFournisseur Boolean                 @default(false)
  fournisseur           FournisseurFichiers
  // Bibliothèque de documents et dossier chez le fournisseur : des identifiants
  // stables, qui survivent à un renommage ou à un déplacement du dossier.
  emplacement           String                  @db.VarChar(255)
  element               String                  @db.VarChar(255)
  // Nom du dossier lors du lien, affiché quand le fournisseur ne répond pas.
  // Un nom de dossier compte jusqu'à 255 caractères.
  nom                   String                  @db.VarChar(255)
  creeParId             String?
  createdAt             DateTime                @default(now())

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  activite     Activite              @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  perimetre    Perimetre?            @relation(fields: [perimetreId], references: [id], onDelete: Cascade)
  creePar      User?                 @relation(fields: [creeParId], references: [id], onDelete: SetNull)
  ressources   RessourceFiche[]
  perimetres   DossierLiePerimetre[]
  groupes      DossierLieGroupe[]
  etatsAcces   EtatAccesDossier[]
  propositions PropositionAcces[]
  permissions  PermissionCreee[]

  @@unique([organisationId, activiteId, perimetreId, emplacement, element])
  @@index([activiteId])
  @@index([perimetreId])
}

// Un périmètre lecteur d'un dossier lié (ADR 0043). Un périmètre archivé ensuite
// garde la lecture, comme ses fiches.
model DossierLiePerimetre {
  dossierLieId String
  perimetreId  String

  dossierLie DossierLie @relation(fields: [dossierLieId], references: [id], onDelete: Cascade)
  perimetre  Perimetre  @relation(fields: [perimetreId], references: [id], onDelete: Cascade)

  @@id([dossierLieId, perimetreId])
  @@index([perimetreId])
}

// Un groupe lecteur d'un dossier lié, désigné par sa clé dans l'activité du dossier.
// Il vaut pour les périmètres non archivés du groupe, y compris ceux qui le
// rejoignent plus tard (ADR 0043).
model DossierLieGroupe {
  dossierLieId String
  groupe       String

  dossierLie DossierLie @relation(fields: [dossierLieId], references: [id], onDelete: Cascade)

  @@id([dossierLieId, groupe])
}

enum TypeRessource {
  DOSSIER
  FICHIER
}

// Dossier ou fichier de l'espace de fichiers lié à une fiche (ADR 0038). Il
// s'adresse depuis un dossier lié par un chemin de noms. Le dossier lié est celui
// du périmètre de la fiche, ou celui de toute son activité : les lecteurs de la
// fiche le lisent donc aussi. La ressource n'entre pas dans le Markdown.
model RessourceFiche {
  id                 String        @id @default(cuid())
  organisationId     String
  ficheId            String
  dossierLieId       String
  // Chemin de noms depuis le dossier lié (tableau de chaînes). Vide : le dossier
  // lié lui-même.
  chemin             Json
  // SHA-256 du chemin : il rend la ressource unique dans sa fiche.
  empreinteChemin    String        @db.Char(64)
  type               TypeRessource
  // Nom lors du lien, affiché quand le fournisseur ne répond pas.
  nom                String        @db.VarChar(255)
  creeParId          String?
  createdAt          DateTime      @default(now())
  // Vrai : un admin de l'organisation ouvre ce document à toute personne qui lit
  // la fiche, partage compris, sans ouvrir le reste du dossier lié (ADR 0043).
  ouverteAuxLecteurs Boolean       @default(false)
  ouverteParId       String?
  ouverteLe          DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  fiche        Fiche        @relation(fields: [ficheId], references: [id], onDelete: Cascade)
  dossierLie   DossierLie   @relation(fields: [dossierLieId], references: [id], onDelete: Cascade)
  creePar      User?        @relation(fields: [creeParId], references: [id], onDelete: SetNull)
  ouvertePar   User?        @relation("RessourceOuvertePar", fields: [ouverteParId], references: [id], onDelete: SetNull)

  @@unique([ficheId, dossierLieId, empreinteChemin])
  @@index([dossierLieId])
  @@index([organisationId])
}

// Dernière écriture d'une fiche dans le dossier d'export de l'espace de fichiers
// (ADR 0038). L'empreinte évite de réécrire une fiche inchangée ; l'étiquette du
// fournisseur révèle une modification faite à la main dans l'espace de fichiers.
model FicheExportee {
  id             String   @id @default(cuid())
  organisationId String
  ficheId        String   @unique
  // Chemin depuis le dossier d'export : activité, périmètre ou « communes », fichier.
  chemin         Json
  // SHA-256 du texte écrit.
  empreinte      String   @db.Char(64)
  etag           String?  @db.VarChar(255)
  exporteeLe     DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  fiche        Fiche        @relation(fields: [ficheId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

// ── Import de listes de bénévoles (ADR 0042) ────────────────────────────────────

// Association enregistrée des colonnes d'un fichier aux champs de Relaytour. Elle
// ne contient aucune donnée personnelle ni aucune séquence.
model CorrespondanceImport {
  id             String   @id @default(cuid())
  organisationId String
  activiteId     String
  nom            String   @db.VarChar(120)
  // Les en-têtes attendus, dans l'ordre du fichier.
  entetes        Json
  // Colonne du fichier → champ de Relaytour, avec ses réglages de colonne.
  associations   Json
  // Valeurs « non », jour par défaut, mode, prévenir par mail.
  reglages       Json
  creeParId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  activite     Activite     @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  creePar      User?        @relation("CorrespondanceImportAuteur", fields: [creeParId], references: [id], onDelete: SetNull)

  @@unique([activiteId, nom])
  @@index([organisationId])
  @@index([creeParId])
}

// Deux fiches qu'un admin de l'activité a déclarées distinctes : leur fusion ne
// se propose plus. La paire se range dans l'ordre des identifiants.
model PaireDistincte {
  id             String   @id @default(cuid())
  organisationId String
  activiteId     String
  benevoleAId    String
  benevoleBId    String
  creeParId      String?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  activite     Activite     @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  benevoleA    Benevole     @relation("PaireDistincteA", fields: [benevoleAId], references: [id], onDelete: Cascade)
  benevoleB    Benevole     @relation("PaireDistincteB", fields: [benevoleBId], references: [id], onDelete: Cascade)
  creePar      User?        @relation("PaireDistincteAuteur", fields: [creeParId], references: [id], onDelete: SetNull)

  @@unique([activiteId, benevoleAId, benevoleBId])
  @@index([organisationId])
  @@index([benevoleAId])
  @@index([benevoleBId])
  @@index([creeParId])
}
