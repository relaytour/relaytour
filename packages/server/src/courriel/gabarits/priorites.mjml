<mjml>
  <mj-head>
    <mj-title>[[Priorités avant le prochain point]]</mj-title>
    <mj-preview>[[Les tâches à traiter en priorité dans vos périmètres.]]</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="24px" color="#010101" padding="0 0 16px" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#040404" width="480px">
    <mj-include path="./_entete.mjml" />

    <mj-section background-color="#FFFFFF" border-radius="12px" padding="28px 24px 20px">
      <mj-column>
        <mj-text font-size="20px" line-height="28px" font-weight="700">
          [[Priorités avant le prochain point]]
        </mj-text>
        <mj-text>
          {{introduction}}
        </mj-text>
        <mj-text>
          {{priorites}}
        </mj-text>
        <mj-button href="{{lienPriorites}}" background-color="#010101" color="#FFFFFF"
                   border-radius="10px" font-size="15px" font-weight="700"
                   padding="8px 0 16px" inner-padding="13px 24px">
          [[Voir les priorités]]
        </mj-button>
        <mj-text font-size="13px" line-height="20px" color="#5B6670" padding="0">
          [[Vous recevez ce mail parce que vous l’avez demandé. Vous pouvez le désactiver dans vos préférences :]] {{lienPreferences}}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="./_pied.mjml" />
  </mj-body>
</mjml>
