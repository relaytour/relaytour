{
  "name": "@relaytour/server",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "worker": "tsx watch --env-file=.env src/worker.ts",
    "schema:print": "tsx scripts/print-schema.ts",
    "gabarits:print": "tsx scripts/gabarits-courriel.ts",
    "courriel:essai": "tsx --env-file=.env scripts/essai-courriel.ts",
    "admin:creer": "tsx --env-file=.env scripts/creer-admin.ts",
    "edition:creer": "tsx --env-file=.env scripts/creer-edition.ts",
    "organisation:creer": "tsx --env-file=.env scripts/creer-organisation.ts",
    "organisation:exporter": "tsx --env-file=.env scripts/exporter-organisation.ts",
    "orga:importer": "tsx --env-file=.env scripts/orga-importer.ts",
    "orga:exporter": "tsx --env-file=.env scripts/orga-exporter.ts",
    "orga:valider": "tsx --env-file-if-exists=.env scripts/orga-valider.ts",
    "planification:lancer": "tsx --env-file=.env scripts/planification-lancer.ts",
    "build": "tsup",
    "start": "node --enable-source-maps dist/server.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@pothos/core": "^4.13.0",
    "@pothos/plugin-complexity": "^4.2.3",
    "@pothos/plugin-prisma": "^4.14.0",
    "@pothos/plugin-scope-auth": "^4.2.1",
    "@prisma/client": "^6.19.0",
    "@relaytour/database": "workspace:*",
    "@relaytour/tokens": "workspace:*",
    "better-auth": "1.7.5",
    "bullmq": "^5.80.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "graphql": "^16.14.0",
    "graphql-scalars": "^1.24.0",
    "ioredis": "^5.11.0",
    "nodemailer": "^9.0.4",
    "pino": "^10.3.1",
    "yaml": "^2.8.1",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/mjml": "^5.0.0",
    "@types/node": "^24.13.0",
    "@types/nodemailer": "^8.0.1",
    "mjml": "^5.4.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.10"
  }
}
