# Copier en .env pour le poste local.
APP_ENV=local
PORT=4400
DATABASE_URL=mysql://relaytour:relaytour-local@127.0.0.1:4410/relaytour
REDIS_URL=redis://127.0.0.1:4411
# Poste local seulement. En recette et en production : openssl rand -base64 48
BETTER_AUTH_SECRET=secret-du-poste-local-a-remplacer-0123456789
# Liste séparée par des virgules.
CORS_ORIGIN=http://localhost:5305
# Origine de l'espace organisateur (liens des mails, origine de confiance de la connexion).
ORIGINE_ORGA=http://localhost:5305

# trace | debug | info | warn | error. Vide : debug en local, info ailleurs.
LOG_LEVEL=

# Vide + APP_ENV=local : Mailpit (127.0.0.1:4415), lisible sur http://localhost:4416.
# Les trois premières variables se renseignent ensemble.
COURRIEL_SMTP_HOTE=
COURRIEL_SMTP_PORT=465
COURRIEL_SMTP_UTILISATEUR=
COURRIEL_SMTP_MOT_DE_PASSE=
COURRIEL_EXPEDITEUR=
# Hors production seulement : adresses qui reçoivent vraiment quand un SMTP réel est renseigné.
COURRIEL_DELIVRABILITE=

# Organisation (en attendant la configuration par organisation, ADR 0006)
ORGANISATION_NOM=Les Rencontres de la Vallée
# Domaines des boîtes partagées admises dans les fiches (liste séparée par des virgules)
DOMAINES_COURRIEL_AUTORISES=exemple.org
# Adresse et page affichées dans l'appel aux référentes et référents (facultatif)
# CONTACT_RECRUTEMENT=contact@exemple.org
# PAGE_EQUIPE=https://exemple.org/equipe
# Dossier de contenu importé par orga:importer (content/exemple par défaut)
# CONTENU_ORGA=/chemin/vers/le/contenu
