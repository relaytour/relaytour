# .env de l'installation (chmod 640). Jamais dans Git.
APP_ENV=prod
IMAGE_REPO=ghcr.io/relaytour/relaytour-server
# Une version précise (x.y.z), ou x.y pour recevoir ses correctifs. L'étiquette
# `main` change à chaque poussée et ne convient pas à une installation.
IMAGE_TAG=0.16.0

API_PORT=4400
# Dossier de l'hôte où l'image -orga dépose l'espace organisateur, servi par Caddy.
ORGA_DIR=/srv/relaytour/orga

MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=relaytour
MARIADB_USER=relaytour
MARIADB_PASSWORD=
DATABASE_URL=mysql://relaytour:<mot-de-passe>@db:3306/relaytour

# openssl rand -base64 48. Le changer déconnecte tout le monde et change les
# adresses des appels à bénévoles et les liens des espaces bénévoles.
BETTER_AUTH_SECRET=

# Mot de passe de Valkey (openssl rand -hex 24) : lettres et chiffres seulement,
# il entre tel quel dans l'adresse redis://.
VALKEY_MOT_DE_PASSE=

CORS_ORIGIN=https://orga.exemple.org
ORIGINE_ORGA=https://orga.exemple.org
LOG_LEVEL=

# Fournisseur SMTP de l'organisation (voir docs/courriel.md). TLS implicite sur 465.
COURRIEL_SMTP_HOTE=
COURRIEL_SMTP_PORT=465
COURRIEL_SMTP_UTILISATEUR=
COURRIEL_SMTP_MOT_DE_PASSE=
COURRIEL_EXPEDITEUR=Les Rencontres de la Vallée <orga@exemple.org>
# true quand la boîte de l'expéditeur ne reçoit pas de courrier (ADR 0053). Sans contact
# déclaré, le pied des mails renvoie alors vers l'espace organisateur. Vide : l'expéditeur
# reçoit les réponses. Valeurs admises : true, false ou vide ; toute autre valeur empêche le
# démarrage.
COURRIEL_EXPEDITEUR_SANS_REPONSE=
# Plafond quotidien des mails de l'installation (ADR 0034), facultatif. Vide : aucun
# plafond. Au-delà, un mail est reporté au lendemain ; le code de connexion part
# toujours. Réglez-le sous le quota quotidien de votre fournisseur de mail.
COURRIEL_PLAFOND_QUOTIDIEN=

# Notifications push (ADR 0024), facultatives. Vides, le canal est fermé et
# l'espace organisateur masque le réglage. Créez la paire de clés une seule fois
# (`npx web-push generate-vapid-keys`) : la changer annule tous les abonnements.
# Le sujet est un contact pour les services de push : mailto: ou https://.
PUSH_VAPID_PUBLIQUE=
PUSH_VAPID_PRIVEE=
PUSH_VAPID_SUJET=

# Espace de fichiers d'une organisation (ADR 0038), facultatif. Vides, l'espace
# organisateur ne propose aucun fournisseur. La clé chiffre les jetons en base :
# 32 octets en base64 (`openssl rand -base64 32`), créés une seule fois.
# SharePoint et OneDrive : l'application inscrite chez Microsoft (voir infra/README.md).
CLE_CHIFFREMENT_ESPACE_FICHIERS=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# « organizations » accepte tout compte professionnel ; un identifiant d'annuaire
# limite la connexion à une seule organisation Microsoft.
MICROSOFT_LOCATAIRE=
# Google Drive par le compte d'un admin : le client OAuth de votre projet Google
# Cloud. Un compte de service ne demande rien ici : l'organisation dépose sa clé.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dropbox par le compte d'un admin : la clé et le secret de votre application
# Dropbox.
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
# Nextcloud : les hôtes que les organisations peuvent désigner, séparés par des
# virgules. « * » admet tout hôte https dont les adresses sont publiques ; un hôte
# nommé (cloud.exemple.org, nuage.lan:8443) est admis même sur un réseau privé.
# Vide, Nextcloud reste fermé.
NEXTCLOUD_HOTES=
# Plusieurs installations qui partagent les mêmes applications de fournisseur :
# l'adresse de retour commune, en https, et l'étiquette de cette installation
# (ADR 0051, voir infra/README.md). Vides, l'adresse de retour reste sous
# ORIGINE_ORGA.
ESPACE_FICHIERS_RETOUR=
ESPACE_FICHIERS_RETOUR_ETIQUETTE=

# Amorçage de l'organisation, avant le premier import de son organisation.yaml (ADR 0006).
# Ces valeurs servent de repli ; la configuration importée prend ensuite le relais.
ORGANISATION_NOM=Les Rencontres de la Vallée
DOMAINES_COURRIEL_AUTORISES=exemple.org
CONTACT_RECRUTEMENT=
PAGE_EQUIPE=

# Hébergement de plusieurs organisations (ADR 0008). Vide en auto-hébergement.
# Adresse ou URL citée quand une limite d'organisation est atteinte.
CONTACT_HEBERGEUR=
# Action du bouton « Support » de l'espace organisateur : une page d'assistance
# en https ou une adresse en mailto:. Elle sert les organisations qui n'ont pas
# déclaré leur propre adresse de support. Vide : le bouton n'apparaît que chez
# ces dernières.
SUPPORT_URL=
# Code source de la version exécutée, lié depuis l'espace organisateur (AGPL,
# article 13). Vide : le dépôt public de Relaytour. Un hébergeur qui modifie le
# logiciel indique son propre dépôt.
CODE_SOURCE_URL=
# Liste des modes d'emploi, liée depuis le menu du compte et le mail d'invitation.
# Vide : les modes d'emploi du site de Relaytour. Un hébergeur qui modifie le
# logiciel indique les siens.
MODES_D_EMPLOI_URL=
# Liste des modes d'emploi en anglais (ADR 0047). Vide : la version anglaise du
# site de Relaytour, ou la liste ci-dessus si l'hébergeur en indique une.
MODES_D_EMPLOI_URL_EN=
# Jeton de l'API d'administration de l'installation (openssl rand -base64 48).
# Vide : l'API d'administration est fermée, seuls les scripts l'exercent.
JETON_ADMINISTRATION=
# Vide ou true : le jeton n'est accepté que sur une requête locale, qui n'est pas
# passée par Caddy (ADR 0013). Un programme de la machine appelle http://127.0.0.1:4400.
# false : le jeton est aussi accepté à travers Caddy, depuis une autre machine.
JETON_ADMINISTRATION_LOCAL=
