# .env de l'installation (chmod 640). Jamais dans Git.
APP_ENV=prod
IMAGE_REPO=ghcr.io/relaytour/relaytour-server
# Une version précise (x.y.z), ou x.y pour recevoir ses correctifs. L'étiquette
# `main` change à chaque poussée et ne convient pas à une installation.
IMAGE_TAG=0.16.0

API_PORT=4400
# Dossier de l'hôte où l'image -orga dépose l'espace organisateur, servi par Caddy.
ORGA_DIR=/srv/relaytour/orga

MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=relaytour
MARIADB_USER=relaytour
MARIADB_PASSWORD=
DATABASE_URL=mysql://relaytour:<mot-de-passe>@db:3306/relaytour

# openssl rand -base64 48
BETTER_AUTH_SECRET=

# Mot de passe de Valkey (openssl rand -hex 24) : lettres et chiffres seulement,
# il entre tel quel dans l'adresse redis://.
VALKEY_MOT_DE_PASSE=

CORS_ORIGIN=https://orga.exemple.org
ORIGINE_ORGA=https://orga.exemple.org
LOG_LEVEL=

# Fournisseur SMTP de l'organisation (voir docs/courriel.md). TLS implicite sur 465.
COURRIEL_SMTP_HOTE=
COURRIEL_SMTP_PORT=465
COURRIEL_SMTP_UTILISATEUR=
COURRIEL_SMTP_MOT_DE_PASSE=
COURRIEL_EXPEDITEUR=Les Rencontres de la Vallée <orga@exemple.org>

# Notifications push (ADR 0024), facultatives. Vides, le canal est fermé et
# l'espace organisateur masque le réglage. Créez la paire de clés une seule fois
# (`npx web-push generate-vapid-keys`) : la changer annule tous les abonnements.
# Le sujet est un contact pour les services de push : mailto: ou https://.
PUSH_VAPID_PUBLIQUE=
PUSH_VAPID_PRIVEE=
PUSH_VAPID_SUJET=

# Amorçage de l'organisation, avant le premier import de son organisation.yaml (ADR 0006).
# Ces valeurs servent de repli ; la configuration importée prend ensuite le relais.
ORGANISATION_NOM=Les Rencontres de la Vallée
DOMAINES_COURRIEL_AUTORISES=exemple.org
CONTACT_RECRUTEMENT=
PAGE_EQUIPE=

# Hébergement de plusieurs organisations (ADR 0008). Vide en auto-hébergement.
# Adresse ou URL citée quand une limite d'organisation est atteinte.
CONTACT_HEBERGEUR=
# Action du bouton « Support » de l'espace organisateur : une page d'assistance
# en https ou une adresse en mailto:. Elle sert les organisations qui n'ont pas
# déclaré leur propre adresse de support. Vide : le bouton n'apparaît que chez
# ces dernières.
SUPPORT_URL=
# Code source de la version exécutée, lié depuis l'espace organisateur (AGPL,
# article 13). Vide : le dépôt public de Relaytour. Un hébergeur qui modifie le
# logiciel indique son propre dépôt.
CODE_SOURCE_URL=
# Liste des modes d'emploi, liée depuis le menu du compte et le mail d'invitation.
# Vide : les modes d'emploi du site de Relaytour. Un hébergeur qui modifie le
# logiciel indique les siens.
MODES_D_EMPLOI_URL=
# Jeton de l'API d'administration de l'installation (openssl rand -base64 48).
# Vide : l'API d'administration est fermée, seuls les scripts l'exercent.
JETON_ADMINISTRATION=
# Vide ou true : le jeton n'est accepté que sur une requête locale, qui n'est pas
# passée par Caddy (ADR 0013). Un programme de la machine appelle http://127.0.0.1:4400.
# false : le jeton est aussi accepté à travers Caddy, depuis une autre machine.
JETON_ADMINISTRATION_LOCAL=
