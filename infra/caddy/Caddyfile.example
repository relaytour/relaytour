# Exemple de /etc/caddy/Caddyfile pour une installation (Caddy sur l'hôte).
# Remplacez les hôtes d'exemple par les vôtres. Caddy obtient et renouvelle les certificats.

# En-têtes communs aux deux hôtes. L'API les pose aussi elle-même : ceux-ci couvrent
# les fichiers de l'espace organisateur et toute réponse que Caddy produit seul.
(entetes-securite) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
}

# Politique de contenu de l'espace organisateur. Tout vient de cette origine :
# scripts, polices et images d'identité ; les styles autorisent l'inline, posé par
# la bibliothèque de composants ; les images des fiches peuvent venir d'un site
# https. Retirez « https: » d'img-src pour les limiter à cette origine. Le préfixe
# « > » remplace la politique de la page que sert l'API : la réponse n'en porte qu'une.
(politique-orga) {
	header >Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
}

# L'API lit l'adresse du client dans X-Relaytour-Ip, que Caddy remplit avec {client_ip}.
# Un intermédiaire devant Caddy (CDN, répartiteur) se déclare dans `trusted_proxies`
# du bloc global `servers`, pour que {client_ip} reste l'adresse du client.
(relais-api) {
	reverse_proxy 127.0.0.1:4400 {
		header_up X-Relaytour-Ip {client_ip}
	}
}

api.exemple.org {
	import entetes-securite
	import relais-api
}

# L'espace organisateur relaie la connexion, GraphQL et les images d'identité vers l'API :
# le navigateur ne parle qu'à une seule origine, et le cookie de session reste de
# première partie (ADR 0002). Les mails citent les images sous /medias/ (ADR 0009).
# /graphql porte aussi le flux des changements (SSE, ADR 0017) : Caddy le transmet
# au fil de l'eau, sans réglage. /agenda/* sert les abonnements à l'agenda (ADR 0037).
# /api/v1/* sert l'API REST des programmes tiers (ADR 0064). /oauth/* et les deux
# documents /.well-known/oauth-* servent l'autorisation des applications tierces
# (ADR 0067). L'écran de consentement (/autoriser/*) reste une page de l'espace.
orga.exemple.org {
	import entetes-securite
	@api path /api/auth/* /api/v1/* /graphql /medias/* /agenda/* /oauth/* /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource*
	handle @api {
		import relais-api
	}
	handle {
		root * /srv/relaytour/orga
		encode zstd gzip
		import politique-orga
		@assets path /assets/*
		# « ? » laisse le « no-cache » de la page servie par l'API à une adresse absente.
		header @assets ?Cache-Control "public, max-age=31536000, immutable"
		# Un fichier existant se sert tel quel. Toute autre adresse, et la racine, est
		# une page de l'application : l'API la sert avec l'aperçu d'un lien partagé,
		# qui nomme l'organisation (ADR 0073).
		@fichier {
			file
			not path /
		}
		handle @fichier {
			file_server
		}
		handle {
			rewrite * /espace/page?{query}
			import relais-api
		}
	}
	# Si l'API ne répond pas, une page se sert depuis le dossier, avec l'aperçu fixe :
	# l'application s'ouvre et affiche son propre message d'erreur. Les chemins de
	# l'API gardent leur erreur. Caddy y voit l'adresse d'origine, avant la réécriture.
	handle_errors 502 503 504 {
		import entetes-securite
		handle @api {
			respond {err.status_code}
		}
		handle {
			import politique-orga
			root * /srv/relaytour/orga
			rewrite * /index.html
			file_server
		}
	}
}
