# Exemple de /etc/caddy/Caddyfile pour une installation (Caddy sur l'hôte).
# Remplacez les hôtes d'exemple par les vôtres. Caddy obtient et renouvelle les certificats.

(entetes-securite) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# L'API lit l'adresse du client dans X-Relaytour-Ip, que Caddy remplit avec {client_ip}.
# Un intermédiaire devant Caddy (CDN, répartiteur) se déclare dans `trusted_proxies`
# du bloc global `servers`, pour que {client_ip} reste l'adresse du client.
(relais-api) {
	reverse_proxy 127.0.0.1:4400 {
		header_up X-Relaytour-Ip {client_ip}
	}
}

api.exemple.org {
	import entetes-securite
	import relais-api
}

# L'espace organisateur relaie la connexion, GraphQL et les images d'identité vers l'API :
# le navigateur ne parle qu'à une seule origine, et le cookie de session reste de
# première partie (ADR 0002). Les mails citent les images sous /medias/ (ADR 0009).
# /graphql porte aussi le flux des changements (SSE, ADR 0017) : Caddy le transmet
# au fil de l'eau, sans réglage.
orga.exemple.org {
	@api path /api/auth/* /graphql /medias/*
	handle @api {
		import relais-api
	}
	handle {
		root * /srv/relaytour/orga
		encode zstd gzip
		import entetes-securite
		header X-Frame-Options DENY
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
