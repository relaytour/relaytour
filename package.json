{
  "name": "relaytour",
  "author": "Quentin Fremeaux",
  "homepage": "https://github.com/relaytour/relaytour#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relaytour/relaytour.git"
  },
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "yarn install && yarn db:up && yarn generate && yarn db:migrate && yarn codegen",
    "db:up": "yarn workspace @relaytour/database docker",
    "db:down": "yarn workspace @relaytour/database docker:down",
    "db:migrate": "yarn workspace @relaytour/database migrate-dev",
    "db:seed": "yarn workspace @relaytour/database seed",
    "db:studio": "yarn workspace @relaytour/database studio",
    "generate": "yarn workspace @relaytour/database generate",
    "codegen": "yarn workspace @relaytour/server schema:print && yarn workspace @relaytour/server gabarits:print && yarn workspace @relaytour/orga codegen",
    "dev": "concurrently -n server,worker,orga -c green,magenta,cyan \"yarn workspace @relaytour/server dev\" \"yarn workspace @relaytour/server worker\" \"yarn workspace @relaytour/orga dev\"",
    "lint": "eslint --cache --cache-strategy content . && yarn workspace @relaytour/orga lint",
    "format": "prettier --write .",
    "test": "yarn workspaces foreach -Apt run test",
    "typecheck": "yarn workspaces foreach -Apt run typecheck",
    "build": "yarn generate && yarn codegen && yarn workspaces foreach -Apt run build",
    "check": "yarn lint && yarn typecheck && yarn build",
    "versionner": "node outils/versionner.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.13.0",
    "concurrently": "^10.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.60.0"
  },
  "license": "AGPL-3.0-only"
}
